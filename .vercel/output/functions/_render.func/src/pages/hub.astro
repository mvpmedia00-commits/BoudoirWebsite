    .section-nav {
      top: 112px;
    }
    .final-cta .container {
      flex-direction: column;
      align-items: flex-start;
    }
    .station-grid {
      grid-template-columns: 1fr;
    }
    .proof-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const trackEvent = (payload) => {
    const tracker = window['mvpTrack'];
    if (typeof tracker === 'function') tracker(payload);
  };

  const track = document.querySelector('[data-track]');
  const prev = document.querySelector('[data-prev]');
  const next = document.querySelector('[data-next]');
  if (track && prev && next) {
    const step = () => Math.max(300, track.clientWidth * 0.8);
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
  }

  const revealTargets = document.querySelectorAll('.reveal');
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const stagger = Number(entry.target.getAttribute('data-stagger') || 0);
          entry.target.style.transitionDelay = `${stagger * 110}ms`;
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.18 }
  );
  revealTargets.forEach((target) => revealObserver.observe(target));

  const parallaxNodes = Array.from(document.querySelectorAll('.parallax'));
  const updateParallax = () => {
    const viewportCenter = window.innerHeight * 0.5;
    parallaxNodes.forEach((node) => {
      const rect = node.getBoundingClientRect();
      const center = rect.top + rect.height * 0.5;
      const distance = center - viewportCenter;
      const speed = Number(node.getAttribute('data-parallax-speed') || 0.06);
      const y = -distance * speed;
      node.style.setProperty('--parallax-y', `${y}px`);
    });
  };
  let parallaxRaf = 0;
  const onScrollParallax = () => {
    if (parallaxRaf) return;
    parallaxRaf = requestAnimationFrame(() => {
      updateParallax();
      parallaxRaf = 0;
    });
  };
  updateParallax();
  window.addEventListener('scroll', onScrollParallax, { passive: true });
  window.addEventListener('resize', onScrollParallax);

  const countTargets = document.querySelectorAll('[data-count]');
  const formatter = (value, suffix) => {
    if (suffix === 'K') return `${Math.round(value / 1000)}K`;
    if (suffix.includes('Mio.')) return `${(value / 1000000).toFixed(1).replace('.0', '')} Mio.`;
    return `${Math.round(value)}`;
  };
  const animateCount = (node) => {
    const value = Number(node.dataset.value || 0);
    const prefix = node.dataset.prefix || '';
    const suffix = node.dataset.suffix || '';
    const start = performance.now();
    const duration = 1300;
    const tick = (now) => {
      const progress = Math.min(1, (now - start) / duration);
      const eased = 1 - Math.pow(1 - progress, 3);
      node.textContent = `${prefix}${formatter(value * eased, suffix)}${suffix === 'K' || suffix.includes('Mio.') ? '' : suffix}`;
      if (progress < 1) requestAnimationFrame(tick);
      else node.textContent = `${prefix}${formatter(value, suffix)}${suffix === 'K' || suffix.includes('Mio.') ? '' : suffix}`;
    };
    requestAnimationFrame(tick);
  };
  const countObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animateCount(entry.target);
          countObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.55 }
  );
  countTargets.forEach((target) => countObserver.observe(target));

  const lightbox = document.querySelector('[data-lightbox]');
  const lightboxContent = document.querySelector('[data-lightbox-content]');
  const closeLightboxButton = document.querySelector('[data-lightbox-close]');

  const clearLightbox = () => {
    if (!lightbox || !lightboxContent) return;
    lightbox.hidden = true;
    lightboxContent.innerHTML = '';
    document.body.style.overflow = '';
  };

  const openLightbox = (media) => {
    if (!lightbox || !lightboxContent) return;
    lightboxContent.innerHTML = '';

    if (media instanceof HTMLVideoElement) {
      const video = document.createElement('video');
      video.controls = true;
      video.autoplay = true;
      video.playsInline = true;
      video.src = media.currentSrc || media.querySelector('source')?.src || '';
      video.poster = media.poster || '';
      lightboxContent.appendChild(video);
    } else if (media instanceof HTMLIFrameElement) {
      const iframe = document.createElement('iframe');
      iframe.src = media.src;
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      lightboxContent.appendChild(iframe);
    } else {
      return;
    }

    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
    trackEvent({
      event_name: 'media_expand',
      page: window.location.pathname,
      source: 'hub',
      element: media instanceof HTMLIFrameElement ? 'iframe' : 'video'
    });
  };

  document.querySelectorAll('[data-expand-trigger]').forEach((button) => {
    button.addEventListener('click', (event) => {
      event.preventDefault();
      const wrap = button.closest('.hero-video-wrap, .media-col, .youtube-frame, .personal-video-wrap');
      if (!wrap) return;
      const media = wrap.querySelector('[data-expandable-video], [data-expandable-iframe]');
      if (media) openLightbox(media);
    });
  });

  closeLightboxButton?.addEventListener('click', clearLightbox);
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (target instanceof HTMLElement && target.closest('[data-lightbox-close]')) {
      clearLightbox();
    }
  });
  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) clearLightbox();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') clearLightbox();
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    const cta = target.closest('.btn-primary, .btn-secondary, .nav-links a, .slider-btn');
    if (!(cta instanceof HTMLElement)) return;
    trackEvent({
      event_name: 'cta_click',
      page: window.location.pathname,
      source: 'hub',
      element: cta.textContent?.trim().slice(0, 40) || 'cta'
    });
  });

  const hydrateStationMedia = async () => {
    try {
      const response = await fetch('/api/media?limit=120', { headers: { Accept: 'application/json' } });
      if (!response.ok) return;
      const data = await response.json();
      const items = Array.isArray(data.items) ? data.items : [];
      if (items.length === 0) return;

      const firstByStation = new Map();
      items.forEach((item) => {
        if (!item || !item.station || firstByStation.has(item.station)) return;
        firstByStation.set(item.station, item);
      });

      document.querySelectorAll('[data-station-media]').forEach((node) => {
        const station = node.getAttribute('data-station-media');
        const item = station ? firstByStation.get(station) : null;
        if (!item) return;

        if (node instanceof HTMLVideoElement) {
          const source = node.querySelector('source');
          if (item.media_type === 'video' && source) {
            source.src = item.media_url;
            node.poster = item.thumb_url || node.poster;
            node.load();
          } else if (item.media_type === 'image') {
            node.poster = item.media_url;
          }
        } else if (node instanceof HTMLIFrameElement) {
          if (item.media_type === 'youtube') {
            node.src = item.media_url;
          }
        }
      });
    } catch {
      // Fallback content already rendered.
    }
  };

  hydrateStationMedia();
</script>
