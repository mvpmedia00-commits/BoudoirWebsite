---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import Header from '../components/Header.astro';
import One from '../assets/blog-placeholder-1.jpg';
import Two from '../assets/blog-placeholder-2.jpg';
import Three from '../assets/blog-placeholder-3.jpg';
import Four from '../assets/blog-placeholder-4.jpg';
import Five from '../assets/blog-placeholder-5.jpg';
import About from '../assets/blog-placeholder-about.jpg';
import { listMediaItems } from '../lib/pocketbase';

const DRIVE_VIDEO_PREVIEW = 'https://drive.google.com/file/d/1RizgFs5c6eV4A7hWAinKD7jsAl_k-xmI/preview';
const HUB_HERO_IMAGE =
	'https://res.cloudinary.com/dg4xwrzu9/image/upload/v1772942536/5B1A2340_hocjor.jpg';

const slices = [
	{
		id: 'branding',
		kicker: 'Branding Content',
		title: 'Recognition Is Never an Accident.',
		image: One.src,
		video: 'https://cdn.coverr.co/videos/coverr-a-city-at-night-1579/1080p.mp4',
		statA: '+100%',
		statB: '+100%',
		metricA: 'Follower Growth',
		metricB: 'Returning Users',
		copy:
			'Consistent visual language and clear storytelling keep your brand memorable.',
		reverse: false
	},
	{
		id: 'edits',
		kicker: 'High Quality Edits',
		title: 'Bad Editing Kills a Great Message.',
		image: Two.src,
		video: 'https://cdn.coverr.co/videos/coverr-a-city-at-night-1579/1080p.mp4',
		statA: '+100%',
		statB: '+1.5Mio.',
		metricA: 'Engagement Rate',
		metricB: 'Video Views',
		copy:
			'Precise editing, timing, and sound design hold attention and deliver your message clearly.',
		reverse: true
	},
	{
		id: 'ugc',
		kicker: 'UGC Content',
		title: 'Standard Content Gets Lost in the Feed.',
		image: Three.src,
		video: 'https://cdn.coverr.co/videos/coverr-a-city-at-night-1579/1080p.mp4',
		statA: '+1Mio.',
		statB: '+10k',
		metricA: 'Views',
		metricB: 'Comments',
		copy:
			'Authentic creator formats build trust, reach, and measurable engagement.',
		reverse: false
	},
	{
		id: 'testimonials',
		kicker: 'Testimonials',
		title: 'Claims Mean Nothing Without Proof.',
		image: Four.src,
		video: 'https://cdn.coverr.co/videos/coverr-a-city-at-night-1579/1080p.mp4',
		statA: '+50%',
		statB: '+4.5%',
		metricA: 'Repeat Purchase Rate',
		metricB: 'Conversion Rate',
		copy:
			'Real voices over vague claims. We produce testimonials that build trust and drive action.',
		reverse: true
	},
	{
		id: 'long-form',
		kicker: 'Long Form Content',
		title: 'Boring Is Worse Than Long.',
		image: Five.src,
		video: 'https://cdn.coverr.co/videos/coverr-a-city-at-night-1579/1080p.mp4',
		statA: '+0%',
		statB: '+100%',
		metricA: 'Bounce Rate',
		metricB: 'Watch Time',
		copy:
			'Long-form content tells deeper stories, keeps attention longer, and builds authority.',
		reverse: false
	},
	{
		id: 'droneshots',
		kicker: 'Drone Shots',
		title: 'Perspective Changes Performance.',
		image: About.src,
		video: 'https://cdn.coverr.co/videos/coverr-a-city-at-night-1579/1080p.mp4',
		statA: '+100%',
		statB: '+20%',
		metricA: 'Recognition',
		metricB: 'More Inquiries',
		copy:
			'Aerial perspective adds depth, motion, and a clear visual advantage to your project.',
		reverse: true
	}
];

const stripImages = [One.src, Two.src, Three.src, Four.src, Five.src, About.src];

const hubSchema = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: 'MVP Media Hub',
	description: 'Vertical-first media hub for branding, edits, UGC, testimonials, long form, and drone content.',
	url: Astro.url.href
};

let hubMediaCount = 0;
try {
	const media = await listMediaItems(undefined, undefined, 200);
	hubMediaCount = media.length;
} catch {
	hubMediaCount = 0;
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Media Hub | ${SITE_TITLE}`}
      description="Media production hub in a vertical-first style."
      keywords="media production, video editing, ugc production, testimonial video, drone video"
      jsonLd={hubSchema}
    />
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
    <link rel="preload" as="image" href={HUB_HERO_IMAGE} />
  </head>
  <body>
    <Header />
    <main class="hub-main hub-page">
      <section class="hub-superhero">
        <img
          class="hub-superhero-image"
          src={HUB_HERO_IMAGE}
          alt="MVP Media hero portrait"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="hub-superhero-overlay"></div>
        <div class="container hub-superhero-content hub-hero">
          <p class="heading">MVP Media Hub</p>
          <h1 class="hub-heading-accent">Big Vision.<br />Cinematic Output.</h1>
          <p class="muted">
            Strategy, production, and post in one workflow. Built for brands that want premium results.
          </p>
          <p class="muted subtle">Media library synced: {hubMediaCount > 0 ? `${hubMediaCount} items` : 'fallback mode'}</p>
          <div class="superhero-actions">
            <a class="btn-primary" href="#hub-start">Explore Hub</a>
            <a class="btn-secondary" href="#youtube-station">YouTube Station</a>
          </div>
        </div>
      </section>
      <div class="hub-container">

      <section class="hero-slice" id="hub-start">
        <div class="container hero-grid">
          <div class="reveal" data-stagger="0">
            <p class="heading">Video Agency</p>
            <h1>Vertical<br />First</h1>
            <p class="lead">A media team with zero tolerance for average work.</p>
            <p class="muted">
              We produce video content for clients who want more than standard. Strategy-led, platform-ready, and focused on impact.
            </p>
            <a class="btn-primary" href="/booking">Get Started</a>
          </div>
          <div class="hero-video-wrap reveal" data-stagger="1">
            <div class="hero-glow"></div>
            <iframe
              data-expandable-iframe
              src={DRIVE_VIDEO_PREVIEW}
              title="MVP Media Featured Reel"
              loading="lazy"
              allow="autoplay; encrypted-media; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
            <button class="expand-btn" type="button" data-expand-trigger aria-label="Open video fullscreen">⤢</button>
          </div>
          <div class="hero-stats reveal" data-stagger="2">
            <div><strong data-count data-value="5000000" data-prefix="+" data-suffix=" Mio.">+5 Mio.</strong><span>Monthly Views</span></div>
            <div><strong data-count data-value="25000" data-prefix="+" data-suffix="K">+25K</strong><span>Produced Videos</span></div>
            <div><strong data-count data-value="100" data-prefix="+" data-suffix="%">+100%</strong><span>Commitment</span></div>
          </div>
        </div>
      </section>

      <section class="trust-banner">
        <div class="container">
          <div class="scroller-track">
            <span>LICHTWUNDER</span><span>SCHUECO</span><span>WICKER</span><span>GELB SOLAR</span>
            <span>OSBORN</span><span>AUTOHAUS HOFFMANN</span><span>TEAMPROJEKT</span>
            <span>LICHTWUNDER</span><span>SCHUECO</span><span>WICKER</span><span>GELB SOLAR</span>
            <span>OSBORN</span><span>AUTOHAUS HOFFMANN</span><span>TEAMPROJEKT</span>
          </div>
        </div>
      </section>

      <nav class="section-nav">
        <div class="container nav-links">
          <a href="#branding">Branding</a>
          <a href="#edits">Edits</a>
          <a href="#ugc">UGC</a>
          <a href="#testimonials">Testimonials</a>
          <a href="#long-form">Long Form</a>
          <a href="#droneshots">Drone</a>
        </div>
      </nav>

      {slices.map((slice, index) => (
        <>
          <section class="video-facts-slice" id={slice.id} data-station={slice.id}>
            <div class="container card-shell hub-card reveal">
              <div class="intro">
                <p class="heading">{slice.kicker}</p>
                <p class="display">{slice.title}</p>
              </div>
              <div class:list={['content-row', { reverse: slice.reverse }]}>
                <div class="media-col reveal" data-stagger="1">
                  <video class="media-video parallax" data-parallax-speed="0.08" data-expandable-video data-station-media={slice.id} autoplay muted loop playsinline preload="metadata" poster={slice.image}>
                    <source src={slice.video} type="video/mp4" />
                  </video>
                  <button class="expand-btn" type="button" data-expand-trigger aria-label="Open video fullscreen">⤢</button>
                </div>
                <div class="text-col reveal" data-stagger="2">
                  <div class="stats-row">
                    <div><strong>{slice.statA}</strong><span>{slice.metricA}</span></div>
                    <div><strong>{slice.statB}</strong><span>{slice.metricB}</span></div>
                  </div>
                  <p>{slice.copy}</p>
                  <button class="btn-primary" type="button">Watch Video</button>
                </div>
              </div>
            </div>
          </section>
          {index < slices.length - 1 && (
            <section class="photo-divider">
              <div class="container">
                <div class:list={['photo-track', { reverse: index % 2 === 1 }]}>
                  {stripImages.map((img) => <img src={img} alt="Portfolio strip preview" loading="lazy" />)}
                  {stripImages.map((img) => <img src={img} alt="Portfolio strip preview" loading="lazy" />)}
                </div>
              </div>
            </section>
          )}
        </>
      ))}

      <section class="services-slice">
        <div class="container reveal" data-stagger="1">
          <p class="heading">Services</p>
          <h2>One Media Agency, Everything You Need</h2>
          <div class="slider-wrap">
            <button class="slider-btn" data-prev aria-label="Previous">‹</button>
            <div class="slider-track" data-track>
              <article class="hub-card"><h3>Concept</h3><p>Strategy, story architecture, and positioning before production.</p></article>
              <article class="hub-card"><h3>Production</h3><p>Shoot planning, on-set direction, and premium capture quality.</p></article>
              <article class="hub-card"><h3>Editing</h3><p>Rhythm, clarity, and messaging tuned for every platform.</p></article>
              <article class="hub-card"><h3>Post Production</h3><p>Visual enhancement, motion, and finishing for maximum impact.</p></article>
              <article class="hub-card"><h3>Color Grading</h3><p>Distinctive looks aligned to your style and brand language.</p></article>
              <article class="hub-card"><h3>Sound Design</h3><p>Music, mix, and sound detail for stronger emotional response.</p></article>
            </div>
            <button class="slider-btn" data-next aria-label="Next">›</button>
          </div>
        </div>
      </section>

      <section class="youtube-station" id="youtube-station">
        <div class="container station-grid reveal" data-stagger="1">
          <div>
            <p class="heading">YouTube Station</p>
            <h2>Channel Highlights</h2>
            <p class="muted">
              Add your latest channel videos here to show long-form authority, case breakdowns, and behind-the-scenes content.
            </p>
            <a class="btn-primary" href="https://www.youtube.com/" target="_blank" rel="noopener noreferrer">Open YouTube</a>
          </div>
          <div class="youtube-frame">
            <iframe
              data-expandable-iframe
              data-station-media="youtube"
              src="https://www.youtube.com/embed/videoseries?list=PLrAXtmRdnEQxwM7lQfV6m4BGr4pJQpQv4"
              title="MVP Media YouTube Station"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
            <button class="expand-btn" type="button" data-expand-trigger aria-label="Open YouTube fullscreen">⤢</button>
          </div>
        </div>
      </section>

      <section class="photo-divider">
        <div class="container">
          <div class="photo-track reverse">
            {stripImages.map((img) => <img src={img} alt="Portfolio strip preview" loading="lazy" />)}
            {stripImages.map((img) => <img src={img} alt="Portfolio strip preview" loading="lazy" />)}
          </div>
        </div>
      </section>

      <section class="personal-station" id="personal-station">
        <div class="container station-grid reveal" data-stagger="1">
          <div>
            <p class="heading">Personal Station</p>
            <h2>Your Signature Video</h2>
            <p class="muted">
              This block is for your personal reel or founder story. Replace the source URL with your own final cut.
            </p>
            <a class="btn-secondary" href="/booking">Start a Project</a>
          </div>
          <div class="personal-video-wrap">
            <iframe
              data-expandable-iframe
              data-station-media="personal"
              src={DRIVE_VIDEO_PREVIEW}
              title="MVP Media Personal Reel"
              loading="lazy"
              allow="autoplay; encrypted-media; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
            <button class="expand-btn" type="button" data-expand-trigger aria-label="Open personal video fullscreen">⤢</button>
          </div>
        </div>
      </section>

      <section class="proof-slice">
        <div class="container proof-grid reveal" data-stagger="1">
          <article class="hub-card">
            <p class="heading">Process</p>
            <h3>Clear production workflow</h3>
            <p>Brief, pre-production, shoot, edit, delivery. Every step has owners, timelines, and review gates.</p>
          </article>
          <article class="hub-card">
            <p class="heading">Trust</p>
            <h3>Built for business outcomes</h3>
            <p>Used by brands, founders, and teams who need content that converts and stays on-brand.</p>
          </article>
          <article class="hub-card">
            <p class="heading">Delivery</p>
            <h3>Platform-ready outputs</h3>
            <p>Exports and cutdowns for paid social, web headers, reels, and campaign landing pages.</p>
          </article>
        </div>
      </section>

      <section class="final-cta">
        <div class="container reveal" data-stagger="1">
          <h2>Outperform the Competition.</h2>
          <a class="btn-primary" href="/booking">Get Started</a>
        </div>
      </section>
      </div>
    </main>
    <div class="media-lightbox" data-lightbox hidden>
      <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close fullscreen media">Close</button>
      <div class="lightbox-content" data-lightbox-content></div>
    </div>
    <Footer />
  </body>
</html>

<style>
  .hub-main {
    background: #070707;
    position: relative;
    isolation: isolate;
  }
  .hub-page {
    background: radial-gradient(circle at top, #1b1410 0%, #050505 55%, #020202 100%);
    min-height: 100vh;
    padding: 80px 20px;
    position: relative;
  }
  .hub-page::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 20% 0%, rgba(196, 106, 123, 0.25), transparent 55%),
      radial-gradient(circle at 80% 100%, rgba(240, 164, 93, 0.18), transparent 55%);
    mix-blend-mode: soft-light;
    pointer-events: none;
  }
  .hub-main::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: 0.12;
    z-index: -1;
    background-image: radial-gradient(circle, #ffffff 1px, transparent 1px);
    background-size: 3px 3px;
  }
  .hub-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 48px 32px;
    background: rgba(12, 12, 12, 0.55);
    backdrop-filter: blur(12px);
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6);
    position: relative;
    z-index: 1;
  }
  .hub-hero {
    text-align: center;
    margin-bottom: 12px;
  }
  .hub-hero h1,
  .hub-container h2 {
    font-family: 'Cormorant Garamond', 'Times New Roman', serif;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: #f5f3f0;
  }
  .hub-hero h1 {
    line-height: 0.88;
  }
  .hub-container h2 {
    line-height: 0.94;
  }
  .hub-container p {
    color: #c8c8c8;
    line-height: 1.7;
  }
  .hub-heading-accent {
    position: relative;
    display: inline-block;
    padding-bottom: 8px;
  }
  .hub-heading-accent::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 64px;
    height: 2px;
    background: linear-gradient(90deg, #d4c2a1, #c46a7b);
    opacity: 0.8;
  }
  .hub-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 24px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .hub-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.45);
  }
  .container {
    width: 100%;
    margin: 0;
    padding-inline: clamp(0.75rem, 2.2vw, 2.2rem);
  }
  .hero-slice,
  .video-facts-slice,
  .photo-divider,
  .services-slice,
  .proof-slice,
  .youtube-station,
  .personal-station,
  .final-cta {
    padding: 2.2rem 0;
  }
  .photo-divider {
    padding: 0.5rem 0 1rem;
    overflow: hidden;
  }
  .photo-track {
    display: flex;
    width: max-content;
    gap: 0.55rem;
    animation: photo-strip-scroll 24s linear infinite;
  }
  .photo-track.reverse {
    animation-direction: reverse;
  }
  .photo-track img {
    width: 154px;
    height: 92px;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    filter: saturate(0.88) contrast(1.02);
  }
  .hub-superhero {
    position: relative;
    min-height: 78vh;
    display: grid;
    align-items: center;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .hub-superhero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 24%;
    opacity: 0.72;
  }
  .hub-superhero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(150deg, rgba(5, 5, 5, 0.75), rgba(5, 5, 5, 0.92));
  }
  .hub-superhero-content {
    position: relative;
    z-index: 1;
    padding: 4.5rem 0 3rem;
  }
  .hub-superhero-content h1 {
    color: #fff;
    text-shadow: 0 12px 35px rgba(0, 0, 0, 0.5);
  }
  .superhero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.9rem;
  }
  .btn-secondary {
    border: 1px solid rgba(255, 255, 255, 0.2);
    text-decoration: none;
    display: inline-block;
    background: rgba(10, 10, 10, 0.6);
    color: #f5f5f5;
    font-weight: 700;
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 999px;
    padding: 0.58rem 0.95rem;
  }
  .station-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 1rem;
    align-items: center;
  }
  .station-grid h2 {
    margin: 0 0 0.7rem;
    color: #fff;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1.1;
  }
  .youtube-frame,
  .personal-video-wrap {
    background: #101010;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    padding: 0.5rem;
  }
  .hero-video-wrap iframe,
  .youtube-frame iframe,
  .personal-video-wrap iframe,
  .personal-video-wrap video {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 10px;
    display: block;
    object-fit: cover;
  }
  .hero-video-wrap,
  .media-col,
  .youtube-frame,
  .personal-video-wrap {
    position: relative;
  }
  .expand-btn {
    position: absolute;
    right: 12px;
    bottom: 12px;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(8, 8, 8, 0.72);
    color: #fff;
    cursor: pointer;
    z-index: 2;
    line-height: 1;
  }
  .media-lightbox {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: rgba(0, 0, 0, 0.9);
    display: grid;
    place-items: center;
    padding: 1rem;
  }
  .media-lightbox[hidden] {
    display: none !important;
  }
  .lightbox-content {
    width: min(1100px, 100%);
  }
  .lightbox-content video,
  .lightbox-content iframe {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 12px;
    display: block;
    background: #000;
  }
  .lightbox-close {
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 100;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(10, 10, 10, 0.75);
    color: #fff;
    border-radius: 999px;
    padding: 0.44rem 0.72rem;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
    pointer-events: auto;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 0.8fr;
    gap: 1rem;
    align-items: center;
  }
  .heading {
    margin: 0 0 0.45rem;
    font-size: 0.78rem;
    color: #ff8da1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    color: #ff8da1;
    line-height: 0.9;
    font-size: clamp(2.4rem, 7vw, 5.4rem);
    text-transform: uppercase;
    text-shadow: 0 16px 40px rgba(255, 141, 161, 0.26);
  }
  .lead {
    margin: 0.8rem 0 0.5rem;
    color: #fff;
    font-size: 1.2rem;
  }
  .muted {
    margin: 0 0 1rem;
    color: #b3b3b3;
    max-width: 45ch;
  }
  .muted.subtle {
    margin-top: -0.4rem;
    font-size: 0.84rem;
    opacity: 0.85;
  }
  .btn-primary {
    border: 0;
    text-decoration: none;
    display: inline-block;
    background: #ff8da1;
    color: #121212;
    font-weight: 700;
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 999px;
    padding: 0.58rem 0.95rem;
    box-shadow: 0 8px 24px rgba(255, 141, 161, 0.25);
    transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
  }
  .btn-primary:hover {
