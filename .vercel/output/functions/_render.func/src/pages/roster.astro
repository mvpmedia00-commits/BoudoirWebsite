---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE } from '../consts';
import { ROSTER_ENTRIES } from '../lib/roster';

const projects = ROSTER_ENTRIES.flatMap((entry) =>
	entry.films.map((film) => ({
		director: entry.name,
		brand: film.format,
		title: film.title,
		slug: entry.slug,
		year: film.year,
		location: entry.location,
		image: entry.heroImage,
		role: entry.role
	}))
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Roster Index | ${SITE_TITLE}`}
			description="Wanda-style project index with live filtering by director, format, and title."
		/>
		<style>
			.page {
				background: #0b0b0b;
				color: #e5e5e5;
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
				font-size: 14px;
				line-height: 1.5;
				min-height: 100vh;
				padding: 2rem 2rem 4rem;
			}
			.container {
				max-width: 1400px;
				margin: 0 auto;
			}
			.header {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				border-bottom: 1px solid #333;
				padding-bottom: 0.75rem;
				margin-bottom: 2rem;
				flex-wrap: wrap;
				gap: 1rem;
			}
			.logo {
				font-size: 1.6rem;
				font-weight: 600;
				letter-spacing: -0.01em;
				color: white;
				text-decoration: none;
			}
			.logo span {
				font-weight: 300;
				color: #aaa;
			}
			.region {
				display: flex;
				gap: 1.5rem;
				color: #888;
				font-size: 0.85rem;
				align-items: center;
			}
			.region a {
				color: #ccc;
				text-decoration: none;
				border-bottom: 1px dotted #555;
			}
			.region a:hover {
				color: white;
				border-bottom: 1px solid white;
			}
			.filter-bar {
				margin-bottom: 1rem;
				display: flex;
				gap: 1rem;
				align-items: center;
				flex-wrap: wrap;
			}
			#searchInput {
				background: #1a1a1a;
				border: 1px solid #333;
				color: #fff;
				padding: 0.6rem 1rem;
				border-radius: 30px;
				font-size: 0.9rem;
				width: min(360px, 100%);
				outline: none;
				transition: border 0.1s;
			}
			#searchInput:focus {
				border-color: #666;
			}
			.count {
				color: #777;
				font-size: 0.9rem;
			}
			.preview {
				margin-bottom: 1.4rem;
				display: grid;
				grid-template-columns: 220px 1fr;
				gap: 0.9rem;
				background: #121212;
				border: 1px solid #2a2a2a;
				border-radius: 10px;
				overflow: hidden;
			}
			.preview img {
				width: 100%;
				height: 100%;
				min-height: 220px;
				object-fit: cover;
				border-radius: 0;
			}
			.preview-info {
				padding: 0.85rem 0.95rem;
				display: grid;
				align-content: center;
				gap: 0.35rem;
			}
			.preview-info p {
				margin: 0;
				color: #9a9a9a;
			}
			.preview-info h2 {
				margin: 0;
				color: #fff;
				font-size: 1.2rem;
			}
			.projects-grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 0.4rem 0;
			}
			@media (min-width: 700px) {
				.projects-grid {
					grid-template-columns: repeat(2, 1fr);
				}
			}
			@media (min-width: 1100px) {
				.projects-grid {
					grid-template-columns: repeat(3, 1fr);
				}
			}
			.project-item {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.3rem 0.2rem;
				border-bottom: 1px solid #1e1e1e;
				color: #b0b0b0;
				transition: background 0.1s;
				flex-wrap: nowrap;
				cursor: pointer;
			}
			.project-item:hover {
				background: #141414;
				color: #fff;
			}
			.project-thumb {
				width: 44px;
				height: 58px;
				flex: 0 0 44px;
				border-radius: 5px;
				object-fit: cover;
				opacity: 0.9;
				border: 1px solid #2d2d2d;
			}
			.director {
				font-weight: 500;
				color: #e0e0e0;
				min-width: 140px;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.brand {
				font-weight: 400;
				color: #888;
				text-transform: uppercase;
				font-size: 0.75rem;
				letter-spacing: 0.03em;
				min-width: 110px;
				white-space: nowrap;
			}
			.title {
				font-weight: 350;
				color: #ccc;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
				flex: 1;
			}
			.title i {
				font-style: italic;
				color: #aaa;
			}
			.no-results {
				padding: 3rem 0;
				text-align: center;
				color: #666;
				grid-column: 1 / -1;
			}
			.footer {
				margin-top: 3rem;
				padding-top: 1.5rem;
				border-top: 1px solid #222;
				display: flex;
				justify-content: space-between;
				color: #666;
				font-size: 0.8rem;
				flex-wrap: wrap;
				gap: 0.8rem;
			}
			.footer a {
				color: #999;
				text-decoration: none;
				border-bottom: 1px dotted #444;
			}
			.footer a:hover {
				color: white;
			}
			@media (max-width: 760px) {
				.preview {
					grid-template-columns: 1fr;
				}
				.preview img {
					min-height: 180px;
				}
			}
		</style>
	</head>
	<body>
		<main class="page">
			<div class="container">
				<div class="header">
					<a href="/" class="logo">MVP<span>+</span></a>
					<div class="region">
						<span>You are located in the United States.</span>
						<a href="/vault">visit private vault</a>
					</div>
				</div>
				<div class="filter-bar">
					<input type="text" id="searchInput" placeholder="Filter by director, format or title..." autocomplete="off" />
					<span class="count" id="projectCount">0 projects</span>
				</div>
				<div class="preview" id="projectPreview">
					<img id="previewImage" src={projects[0]?.image || ''} alt={projects[0]?.director || 'Project preview'} />
					<div class="preview-info">
						<p id="previewRole">{projects[0]?.role || ''}</p>
						<h2 id="previewDirector">{projects[0]?.director || ''}</h2>
						<p id="previewTitle">{projects[0]?.title ? `"${projects[0]?.title}"` : ''}</p>
						<p id="previewMeta">{projects[0]?.brand || ''} · {projects[0]?.year || ''} · {projects[0]?.location || ''}</p>
					</div>
				</div>
				<div class="projects-grid" id="projectGrid"></div>
				<div class="footer">
					<span>This index is for navigation and showcase purposes. <a href="/about">learn more here</a></span>
					<span>© MVP Media</span>
				</div>
			</div>
		</main>
		<script type="application/json" id="roster-project-data" set:html={JSON.stringify(projects)}></script>
		<script>
			const dataEl = document.getElementById('roster-project-data');
			const projects = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
			const gridEl = document.getElementById('projectGrid');
			const searchInput = document.getElementById('searchInput');
			const countEl = document.getElementById('projectCount');
			const previewImage = document.getElementById('previewImage');
			const previewRole = document.getElementById('previewRole');
			const previewDirector = document.getElementById('previewDirector');
			const previewTitle = document.getElementById('previewTitle');
			const previewMeta = document.getElementById('previewMeta');

			function setPreview(proj) {
				if (!proj) return;
				if (previewImage instanceof HTMLImageElement) {
					previewImage.src = proj.image || '';
					previewImage.alt = proj.director || 'Project preview';
				}
				if (previewRole) previewRole.textContent = proj.role || '';
				if (previewDirector) previewDirector.textContent = proj.director || '';
				if (previewTitle) previewTitle.textContent = proj.title ? `"${proj.title}"` : '';
				if (previewMeta) previewMeta.textContent = `${proj.brand || ''} · ${proj.year || ''} · ${proj.location || ''}`;
			}

			function render(filterText = '') {
				const filterLower = filterText.toLowerCase();
				let visibleCount = 0;
				gridEl.innerHTML = '';
				let firstMatch = null;

				projects.forEach((proj) => {
					const searchable = `${proj.director} ${proj.brand} ${proj.title} ${proj.year} ${proj.location}`.toLowerCase();
					if (filterText && !searchable.includes(filterLower)) return;
					visibleCount += 1;
					if (!firstMatch) firstMatch = proj;

					const item = document.createElement('div');
					item.className = 'project-item';
					item.addEventListener('mouseenter', () => setPreview(proj));

					const thumb = document.createElement('img');
					thumb.className = 'project-thumb';
					thumb.src = proj.image || '';
					thumb.alt = proj.director || 'thumbnail';

					const dirSpan = document.createElement('span');
					dirSpan.className = 'director';
					dirSpan.textContent = proj.director || '-';

					const brandSpan = document.createElement('span');
					brandSpan.className = 'brand';
					brandSpan.textContent = proj.brand || '';

					const titleSpan = document.createElement('span');
					titleSpan.className = 'title';
					titleSpan.innerHTML = proj.title ? `<i>${proj.title}</i>` : '';

					item.appendChild(thumb);
					item.appendChild(dirSpan);
					item.appendChild(brandSpan);
					item.appendChild(titleSpan);
					item.addEventListener('click', () => {
						window.location.href = `/roster/${proj.slug}/`;
					});
					gridEl.appendChild(item);
				});

				if (visibleCount === 0) {
					const noMsg = document.createElement('div');
					noMsg.className = 'no-results';
					noMsg.textContent = 'No projects match your filter.';
					gridEl.appendChild(noMsg);
				}

				if (firstMatch) setPreview(firstMatch);

				if (countEl) {
					countEl.textContent = `${visibleCount} project${visibleCount !== 1 ? 's' : ''}`;
				}
			}

			render('');
			searchInput?.addEventListener('input', (e) => {
				render(e.target?.value || '');
			});
		</script>
	</body>
</html>
