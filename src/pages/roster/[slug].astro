---
import BaseHead from '../../components/BaseHead.astro';
import { SITE_TITLE } from '../../consts';
import { getRosterEntryBySlug, ROSTER_SLUGS } from '../../lib/roster';

export function getStaticPaths() {
	return ROSTER_SLUGS.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug || '';
const entry = getRosterEntryBySlug(slug);

if (!entry) {
	return Astro.redirect('/roster');
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${entry.name} | ${SITE_TITLE}`}
			description={`${entry.role} profile, selected work, and credits.`}
		/>
		<style>
			.page {
				background: #090909;
				color: #e8e8e8;
				min-height: 100vh;
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
			}
			.container {
				max-width: 1380px;
				margin: 0 auto;
				padding: 1.25rem 1.2rem 3rem;
			}
			.topbar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				border-bottom: 1px solid #242424;
				padding-bottom: 0.75rem;
				margin-bottom: 1rem;
				gap: 0.75rem;
				flex-wrap: wrap;
			}
			.back-link {
				color: #d5d5d5;
				text-decoration: none;
				font-size: 0.82rem;
				letter-spacing: 0.06em;
				text-transform: uppercase;
			}
			.back-link:hover {
				color: #ffffff;
			}
			.badge {
				color: #8f8f8f;
				font-size: 0.82rem;
			}
			.hero {
				display: grid;
				grid-template-columns: 1.15fr 0.85fr;
				gap: 0.85rem;
				margin-bottom: 0.8rem;
			}
			.hero-image,
			.hero-reel {
				position: relative;
				border: 1px solid #242424;
				background: #131313;
				overflow: hidden;
				min-height: 480px;
			}
			.hero-image img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				filter: contrast(1.04);
			}
			.hero-reel iframe {
				width: 100%;
				height: 100%;
				border: 0;
			}
			.hero-title {
				position: absolute;
				left: 1rem;
				bottom: 1rem;
				background: rgba(0, 0, 0, 0.45);
				backdrop-filter: blur(2px);
				padding: 0.6rem 0.75rem;
				border: 1px solid rgba(255, 255, 255, 0.22);
				max-width: min(90%, 540px);
			}
			.hero-title p {
				margin: 0;
			}
			.hero-title .eyebrow {
				text-transform: uppercase;
				font-size: 0.68rem;
				letter-spacing: 0.1em;
				color: #b3b3b3;
			}
			.hero-title h1 {
				margin: 0.35rem 0 0;
				font-size: clamp(1.35rem, 3vw, 2.15rem);
				line-height: 1.1;
				letter-spacing: -0.01em;
				color: #ffffff;
			}
			.meta-rail {
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				gap: 0.65rem;
				margin-bottom: 1rem;
			}
			.meta-box {
				border: 1px solid #242424;
				background: #0f0f0f;
				padding: 0.65rem 0.75rem;
			}
			.meta-box .label {
				margin: 0;
				text-transform: uppercase;
				font-size: 0.64rem;
				letter-spacing: 0.1em;
				color: #878787;
			}
			.meta-box .value {
				margin: 0.2rem 0 0;
				font-size: 0.95rem;
				color: #ececec;
			}
			.columns {
				display: grid;
				grid-template-columns: 1.25fr 0.75fr;
				gap: 0.85rem;
				align-items: start;
			}
			.section-card {
				border: 1px solid #242424;
				background: #0f0f0f;
				padding: 0.85rem 0.9rem;
			}
			.section-title {
				margin: 0 0 0.75rem;
				font-size: 0.77rem;
				letter-spacing: 0.09em;
				text-transform: uppercase;
				color: #999999;
			}
			.bio {
				margin: 0;
				color: #cfcfcf;
				font-size: 0.96rem;
			}
			.film-list {
				display: grid;
				gap: 0.55rem;
			}
			.film-row {
				display: grid;
				grid-template-columns: auto 1fr auto;
				gap: 0.6rem;
				align-items: baseline;
				border-bottom: 1px solid #1f1f1f;
				padding: 0.5rem 0.1rem;
			}
			.film-year {
				color: #8d8d8d;
				font-size: 0.8rem;
				min-width: 3ch;
			}
			.film-main {
				margin: 0;
				color: #efefef;
				font-size: 0.96rem;
			}
			.film-main span {
				display: block;
				color: #9e9e9e;
				font-size: 0.83rem;
				margin-top: 0.18rem;
			}
			.film-format {
				color: #b9b9b9;
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
			}
			.tag-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
			}
			.tag-list li {
				border: 1px solid #353535;
				background: #131313;
				padding: 0.26rem 0.52rem;
				font-size: 0.8rem;
				color: #d7d7d7;
			}
			.bullet-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 0.4rem;
			}
			.bullet-list li {
				color: #cfcfcf;
				font-size: 0.9rem;
				border-bottom: 1px solid #1f1f1f;
				padding-bottom: 0.35rem;
			}
			.likes-row {
				display: flex;
				align-items: center;
				gap: 0.55rem;
				margin-top: 0.65rem;
			}
			.like-btn {
				background: #171717;
				border: 1px solid #3a3a3a;
				color: #f0f0f0;
				padding: 0.35rem 0.75rem;
				font-size: 0.82rem;
				cursor: pointer;
				text-transform: uppercase;
				letter-spacing: 0.06em;
			}
			.like-btn:hover {
				background: #212121;
			}
			.like-count {
				color: #999999;
				font-size: 0.86rem;
			}
			[data-reveal] {
				opacity: 0;
				transform: translateY(16px);
				transition: opacity 600ms ease, transform 600ms ease;
				will-change: transform, opacity;
			}
			[data-reveal].is-visible {
				opacity: 1;
				transform: translateY(0);
			}
			@media (max-width: 1020px) {
				.hero,
				.columns {
					grid-template-columns: 1fr;
				}
				.hero-image,
				.hero-reel {
					min-height: 340px;
				}
				.meta-rail {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}
			@media (max-width: 620px) {
				.meta-rail {
					grid-template-columns: 1fr;
				}
				.film-row {
					grid-template-columns: 1fr;
					gap: 0.25rem;
				}
			}
		</style>
	</head>
	<body>
		<main class="page">
			<div class="container">
				<div class="topbar" data-reveal>
					<a class="back-link" href="/roster">Back to roster</a>
					<p class="badge">MVP+ PROFILE FILE</p>
				</div>

				<section class="hero" data-reveal>
					<div class="hero-image">
						<img src={entry.heroImage} alt={entry.name} />
						<div class="hero-title">
							<p class="eyebrow">{entry.role}</p>
							<h1>{entry.name}</h1>
						</div>
					</div>
					<div class="hero-reel">
						<iframe
							src={entry.reelUrl}
							title={`${entry.name} reel`}
							loading="lazy"
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
							allowfullscreen
						></iframe>
					</div>
				</section>

				<section class="meta-rail" data-reveal>
					<div class="meta-box">
						<p class="label">Location</p>
						<p class="value">{entry.location}</p>
					</div>
					<div class="meta-box">
						<p class="label">Availability</p>
						<p class="value">{entry.availability}</p>
					</div>
					<div class="meta-box">
						<p class="label">Represented By</p>
						<p class="value">{entry.representedBy}</p>
					</div>
					<div class="meta-box">
						<p class="label">Primary Role</p>
						<p class="value">{entry.role}</p>
					</div>
				</section>

				<section class="columns">
					<div class="section-card" data-reveal>
						<h2 class="section-title">Profile</h2>
						<p class="bio">{entry.bio}</p>
					</div>
					<div class="section-card" data-reveal>
						<h2 class="section-title">Focus</h2>
						<ul class="tag-list">
							{entry.focus.map((item) => <li>{item}</li>)}
						</ul>
					</div>
				</section>

				<section class="columns" style="margin-top: 0.85rem;">
					<div class="section-card" data-reveal>
						<h2 class="section-title">Selected Work</h2>
						<div class="film-list">
							{entry.films.map((film) => (
								<div class="film-row">
									<p class="film-year">{film.year}</p>
									<p class="film-main">
										{film.title}
										{film.oneLiner && <span>{film.oneLiner}</span>}
									</p>
									<p class="film-format">{film.format}</p>
								</div>
							))}
						</div>
					</div>
					<div style="display: grid; gap: 0.85rem;">
						<div class="section-card" data-reveal>
							<h2 class="section-title">Awards</h2>
							<ul class="bullet-list">
								{entry.awards.map((award) => <li>{award}</li>)}
							</ul>
						</div>
						<div class="section-card" data-reveal>
							<h2 class="section-title">Likes</h2>
							<ul class="bullet-list">
								{entry.likes.map((like) => <li>{like}</li>)}
							</ul>
							<div class="likes-row">
								<button type="button" class="like-btn" data-like-btn>Like Profile</button>
								<span class="like-count">Likes: <strong data-like-count>0</strong></span>
							</div>
						</div>
					</div>
				</section>
			</div>
		</main>
		<script is:inline>
			const likeBtn = document.querySelector('[data-like-btn]');
			const likeCount = document.querySelector('[data-like-count]');
			const key = `mvp-roster-like-${location.pathname}`;
			const current = Number(localStorage.getItem(key) || '0');
			if (likeCount) likeCount.textContent = String(current);
			likeBtn?.addEventListener('click', () => {
				const next = Number(localStorage.getItem(key) || '0') + 1;
				localStorage.setItem(key, String(next));
				if (likeCount) likeCount.textContent = String(next);
			});

			const revealItems = document.querySelectorAll('[data-reveal]');
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((item) => {
						if (item.isIntersecting) {
							item.target.classList.add('is-visible');
							observer.unobserve(item.target);
						}
					});
				},
				{ threshold: 0.12, rootMargin: '0px 0px -30px 0px' }
			);
			revealItems.forEach((item) => observer.observe(item));
		</script>
	</body>
</html>
