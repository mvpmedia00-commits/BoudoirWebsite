---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { SITE_MEDIA } from '../data/siteMedia';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About | ${SITE_TITLE}`}
			description="Meet Matthew Phillips, the photographer and director behind MVP Media, creating fine art boudoir and portrait work across the United States."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="about-grid">
				<div class="about-photo">
					<img data-portfolio src={SITE_MEDIA.about} alt="Portrait by Matthew Phillips" loading="lazy" />
				</div>
				<div>
					<p class="eyebrow">Meet the Photographer</p>
					<h1>I'm Matthew Phillips.</h1>
					<p>
						I founded MVP Media to make fine art boudoir and portraiture that feels as considered as an editorial shoot,
						with a process that stays calm, clear, and private from the first message to the final gallery.
					</p>
					<p>
						My work focuses on boudoir, artistic nude, body paint, and After Dark editorial sessions, alongside short films.
						Every project begins with a conversation about what you want to feel and what you are comfortable with, and ends
						with images delivered with discretion.
					</p>
					<div class="hero-actions">
						<a class="btn btn-solid" href="/booking">Book a Consultation</a>
						<a class="btn btn-ghost" href="/gallery">View Portfolio</a>
					</div>
				</div>
			</section>

			<section class="values">
				<article>
					<h2>Guided from start to finish</h2>
					<p>You never have to wonder what to do next. I guide the pace, the posing, and every step of the day.</p>
				</article>
				<article>
					<h2>Color that lasts</h2>
					<p>Clean, cinematic grading that looks right in print and on screen, today and years from now.</p>
				</article>
				<article>
					<h2>A gallery that tells a story</h2>
					<p>Your final images are sequenced as a set, not a pile of files, and sized for print, web, and social.</p>
				</article>
			</section>
		</main>
		<Footer />
	</body>
</html>
