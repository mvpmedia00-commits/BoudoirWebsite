---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import ExplicitLock from '../components/ui/ExplicitLock.astro';
import StripMedia from '../components/ui/StripMedia.astro';
import { BOUDOIR_FILM_STRIP, SITE_MEDIA, STRIP_MEDIA, type StripItem } from '../data/siteMedia';

// Explicit-mode banner at the top of the page: a looping video (it already carries the MVP Media
// title), picked at random on each visit. Full HD for larger screens, 720p for phones; the first
// frame shows while it loads. Add a variant by uploading its three files and listing it here.
const BUNNY = 'https://boudoir123mvp.b-cdn.net';
const BANNER_VIDEOS = ['films-hero-explicit', 'films-hero-explicit-2', 'films-hero-explicit-3', 'films-hero-explicit-4'].map((name) => ({
	hd: `${BUNNY}/${name}.mp4`,
	sd: `${BUNNY}/${name}-720.mp4`,
	poster: `${BUNNY}/${name}-poster.jpg`
}));
const FEATURED_FILM = 'https://drive.google.com/file/d/1RizgFs5c6eV4A7hWAinKD7jsAl_k-xmI/preview';

// Google Drive's embeddable player for a file ID. The file must be shared as "Anyone with the link".
const drivePreview = (fileId: string) => `https://drive.google.com/file/d/${fileId}/preview`;

// Bunny Stream's embeddable player for a video in a library. The library and video IDs are the two
// parts of the video's share link: player.mediadelivery.net/play/<library>/<video>.
const bunnyStream = (libraryId: string, videoId: string) =>
	`https://player.mediadelivery.net/embed/${libraryId}/${videoId}?autoplay=false&preload=false&responsive=true`;

type FilmType = {
	id: string;
	nav: string;
	title: string;
	copy: string;
	image: string;
	/** Optional Bunny Stream embed URL (see bunnyStream); shows the film instead of the photo. */
	streamVideo?: string;
	/** Optional Google Drive file ID; used when there is no streamVideo. */
	driveVideo?: string;
	/** More films for this section (embed URLs); arrow buttons on the player switch between them. */
	moreVideos?: string[];
	/** Photos and clips for the strip right under this section; defaults to STRIP_MEDIA. */
	stripBelow?: StripItem[];
	/** Shape of the video player box; '16 / 9' for horizontal films, '9 / 16' for vertical ones. */
	videoAspect?: string;
	/** Contains nudity: plays only in Explicit mode; PG-13 mode shows a "turn on Explicit" card. */
	mature?: boolean;
};

// A vertical player (taller than wide) gets a phone-sized width instead of the full column.
const isVertical = (aspect = '16 / 9') => {
	const [w, h] = aspect.split('/').map(Number);
	return h > w;
};

const filmTypes: FilmType[] = [
	{
		id: 'boudoir',
		mature: true,
		nav: 'Boudoir',
		title: 'Boudoir Films',
		copy: 'A short, private film made alongside your photo session. Slow movement, soft light, and the same guided direction as the stills.',
		image: SITE_MEDIA.one,
		streamVideo: bunnyStream('762418', '48e67cc3-ae74-4afa-b0ce-59c0078d3fa5'),
		stripBelow: BOUDOIR_FILM_STRIP,
		videoAspect: '16 / 9'
	},
	{
		id: 'artistic',
		mature: true,
		nav: 'Artistic Motion',
		title: 'Artistic Motion Studies',
		copy: 'Fine-art studies of form and shadow, shot and graded like cinema. Built around composition rather than trend.',
		image: SITE_MEDIA.two,
		streamVideo: bunnyStream('762418', 'f6ed97c8-cccd-4698-ab44-1c03ea01c090'),
		videoAspect: '16 / 9'
	},
	{
		id: 'body-paint',
		mature: true,
		nav: 'Body Paint',
		title: 'Body Paint Process Films',
		copy: 'The transformation from bare canvas to finished piece, captured from first brushstroke to final frame.',
		image: SITE_MEDIA.three,
		streamVideo: bunnyStream('762418', 'fad52987-589f-4853-a43c-85b4d1abd08e'),
		moreVideos: [drivePreview('162NXf9r53mY6q6u6YQ3mMJ7YIRluOpx_')],
		videoAspect: '16 / 9'
	},
	{
		id: 'editorial',
		nav: 'Editorial',
		title: 'Editorial and Brand Films',
		copy: 'Portrait-led motion for creators, campaigns, and lookbooks, with no nudity and cut for every platform you publish on.',
		image: SITE_MEDIA.about,
		streamVideo: bunnyStream('762418', 'abfb40ce-93fa-4214-81e2-33b83220b148'),
		videoAspect: '9 / 16'
	}
];

const craft = [
	{ title: 'Concept and Treatment', copy: 'Mood, references, wardrobe, and boundaries agreed before anything is filmed.' },
	{ title: 'Direction and Capture', copy: 'Calm, guided direction on a closed set, with lighting designed for skin and shadow.' },
	{ title: 'Edit and Pacing', copy: 'An edit that breathes. Rhythm and restraint over fast cuts.' },
	{ title: 'Color Grading', copy: 'A cinematic grade matched to your stills, so the photos and the film feel like one body of work.' },
	{ title: 'Sound and Music', copy: 'Music and a clean mix chosen to suit the mood of the film.' },
	{ title: 'Private Delivery', copy: 'Secure, private delivery in the formats you need, from a full-length cut to short vertical versions.' }
];

const steps = [
	{ title: 'Consultation', copy: 'We talk through your idea, comfort level, and how the film will be used.' },
	{ title: 'Planning', copy: 'Treatment, schedule, location, and wardrobe are mapped and confirmed.' },
	{ title: 'Filming', copy: 'A relaxed, directed session on a closed set.' },
	{ title: 'Edit and Delivery', copy: 'The film is edited and graded, then your final files are delivered privately.' }
];

// Photos and clips for the scrolling strips between sections. One loop must be wider than the widest
// screen (about 3,300px here), and the strip is drawn twice so the loop is seamless.
const toTrack = (items: StripItem[]) => {
	const loop = Array.from({ length: Math.ceil(25 / items.length) }, () => items).flat();
	return [...loop, ...loop];
};
const stripTrack = toTrack(STRIP_MEDIA);
// The strip above each section is the one below the previous section.
const trackAbove = (index: number) => {
	const below = filmTypes[index - 1]?.stripBelow;
	return below ? toTrack(below) : stripTrack;
};

const sectionNav = [
	{ href: '#reel', label: 'The Reel' },
	...filmTypes.map((film) => ({ href: `#${film.id}`, label: film.nav })),
	{ href: '#craft', label: 'The Craft' },
	{ href: '#process', label: 'Process' }
];

const filmsSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: `${SITE_TITLE} Films`,
	serviceType: 'Boudoir and fine art film production',
	provider: { '@type': 'Organization', name: SITE_TITLE },
	areaServed: 'United States',
	url: Astro.url.href
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Films | ${SITE_TITLE}`}
			description="Boudoir, fine art, body paint, and editorial films, directed, graded, and delivered privately across the United States."
			image={SITE_MEDIA.about}
			jsonLd={filmsSchema}
		/>
	</head>
	<body>
		<Header />
		<main class="films">
			<section class="films-banner" data-explicit aria-label="Films">
				<video
					data-banner-video
					data-variants={JSON.stringify(BANNER_VIDEOS)}
					autoplay
					muted
					loop
					playsinline
					preload="none"
					aria-label="MVP Media: photographer and model in a red-lit studio. Own the frame. Photography, videography, branding, creative media."
				></video>
				<script is:inline>
					// Explicit mode only: pick one of the banner videos at random and load it (720p on phones and
					// data-saver connections). Its first frame is set as data-poster, which Header applies.
					(function () {
						if (!document.documentElement.classList.contains('explicit')) return;
						var video = document.querySelector('[data-banner-video]');
						if (!video) return;
						var variants = JSON.parse(video.getAttribute('data-variants') || '[]');
						if (!variants.length) return;
						var pick = variants[Math.floor(Math.random() * variants.length)];
						var small = window.innerWidth < 900 || (navigator.connection && navigator.connection.saveData);
						video.setAttribute('data-poster', pick.poster);
						video.src = small ? pick.sd : pick.hd;
						var play = video.play();
						if (play && play.catch) play.catch(function () {});
					})();
				</script>
				<div class="films-shell films-banner-bar">
					<h1>Motion, made with the same care as the still.</h1>
					<div class="hero-actions">
						<a class="btn btn-solid" href="/booking">Discuss a Film</a>
						<a class="btn btn-ghost" href="#reel">Watch the Reel</a>
					</div>
				</div>
			</section>

			<section class="films-hero" data-safe>
				<img class="films-hero-image parallax" data-parallax-speed="0.12" src={SITE_MEDIA.about} alt="" loading="eager" fetchpriority="high" decoding="async" />
				<div class="films-hero-overlay"></div>
				<div class="films-shell films-hero-content">
					<p class="eyebrow reveal" data-stagger="0">Films</p>
					<h1 class="reveal" data-stagger="1">Motion, made with the same care as the still.</h1>
					<p class="lead reveal" data-stagger="2">
						Short, cinematic films for boudoir, fine art, body paint, and editorial clients. Directed on a closed set,
						graded like cinema, and delivered privately.
					</p>
					<div class="hero-actions reveal" data-stagger="3">
						<a class="btn btn-solid" href="/booking">Discuss a Film</a>
						<a class="btn btn-ghost" href="#reel">Watch the Reel</a>
					</div>
				</div>
			</section>

			<nav class="section-nav" aria-label="Films sections">
				<div class="films-shell section-nav-links">
					{sectionNav.map((item) => <a href={item.href} data-section-link>{item.label}</a>)}
				</div>
			</nav>

			<section class="slice" id="reel" data-section>
				<div class="films-shell">
					<div class="card-shell featured-grid reveal">
						<div>
							<p class="eyebrow">Featured</p>
							<h2 class="accent">The Reel</h2>
							<p>
								A selection of recent motion work: light, movement, and restraint. Every film begins with a consultation
								and ends with private delivery.
							</p>
							<a class="btn btn-ghost" href="/booking">Start a Project</a>
						</div>
						<div class="film-frame" data-explicit>
							<iframe
								data-explicit-src={FEATURED_FILM}
								title={`${SITE_TITLE} featured reel`}
								loading="lazy"
								allow="autoplay; encrypted-media; picture-in-picture"
								allowfullscreen
							></iframe>
						</div>
						<div class="film-frame" data-safe>
							<ExplicitLock label="Explicit film" action />
						</div>
					</div>
				</div>
			</section>

			{filmTypes.map((film, index) => (
				<>
					<div class="photo-divider" aria-hidden="true">
						<div class:list={['photo-track', { reverse: index % 2 === 1 }]}>
							{trackAbove(index).map((item) => <StripMedia item={item} />)}
						</div>
					</div>

					<section class="slice" id={film.id} data-section>
						<div class="films-shell">
							<article class="card-shell reveal">
								<header class="slice-intro">
									<p class="film-index">{String(index + 1).padStart(2, '0')} / {String(filmTypes.length).padStart(2, '0')}</p>
									<h2 class="accent">{film.title}</h2>
								</header>
								<div class:list={['content-row', { reverse: index % 2 === 1 }]}>
									<div class="media-col reveal" data-stagger="1">
										{film.mature && (
											<div
												class:list={['film-media', 'is-video', { 'is-vertical': isVertical(film.videoAspect) }]}
												style={`aspect-ratio: ${film.videoAspect ?? '16 / 9'};`}
												data-safe
											>
												<ExplicitLock label="Explicit film" action />
											</div>
										)}
										{film.streamVideo || film.driveVideo ? (
											<div
												class:list={['film-media', 'is-video', { 'is-vertical': isVertical(film.videoAspect) }]}
												style={`aspect-ratio: ${film.videoAspect ?? '16 / 9'};`}
												data-explicit={film.mature ? '' : undefined}
												data-film-switcher={film.moreVideos?.length ? '' : undefined}
											>
												<iframe
													data-film-slide
													src={film.mature ? undefined : (film.streamVideo ?? drivePreview(film.driveVideo ?? ''))}
													data-explicit-src={film.mature ? (film.streamVideo ?? drivePreview(film.driveVideo ?? '')) : undefined}
													title={`${film.title} by ${SITE_TITLE}`}
													loading="lazy"
													allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture"
													allowfullscreen
												></iframe>
												{film.moreVideos?.map((url, i) => (
													<iframe
														data-film-slide
														data-film-src={url}
														hidden
														title={`${film.title}, film ${i + 2}, by ${SITE_TITLE}`}
														loading="lazy"
														allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture"
														allowfullscreen
													></iframe>
												))}
												{film.moreVideos?.length ? (
													<>
														<button type="button" class="film-nav film-nav-prev" data-film-prev aria-label="Previous film">&lsaquo;</button>
														<button type="button" class="film-nav film-nav-next" data-film-next aria-label="Next film">&rsaquo;</button>
														<span class="film-count" data-film-count aria-live="polite">1 / {film.moreVideos.length + 1}</span>
													</>
												) : null}
											</div>
										) : (
											<div class="film-media is-photo">
												<img class="parallax" data-parallax-speed="0.06" src={film.image} alt="" loading="lazy" decoding="async" />
											</div>
										)}
									</div>
									<div class="text-col reveal" data-stagger="2">
										<p>{film.copy}</p>
										<a class="btn btn-solid" href="/booking">Discuss a Film</a>
									</div>
								</div>
							</article>
						</div>
					</section>
				</>
			))}

			<div class="photo-divider" aria-hidden="true">
				<div class="photo-track">
					{stripTrack.map((item) => <StripMedia item={item} />)}
				</div>
			</div>

			<section class="slice slice--warm" id="craft" data-section>
				<div class="films-shell reveal">
					<p class="eyebrow">The Craft</p>
					<h2 class="accent">What every film includes</h2>
					<div class="slider-wrap">
						<button class="slider-btn" type="button" data-prev aria-label="Previous">&lsaquo;</button>
						<div class="slider-track" data-slider>
							{craft.map((item) => (
								<article class="slide-card">
									<h3>{item.title}</h3>
									<p>{item.copy}</p>
								</article>
							))}
						</div>
						<button class="slider-btn" type="button" data-next aria-label="Next">&rsaquo;</button>
					</div>
				</div>
			</section>

			<section class="slice" id="process" data-section>
				<div class="films-shell">
					<header class="reveal">
						<p class="eyebrow">Process</p>
						<h2 class="accent">From first call to final cut</h2>
					</header>
					<ol class="steps">
						{steps.map((step, index) => (
							<li class="reveal" data-stagger={index}>
								<span class="step-number">{String(index + 1).padStart(2, '0')}</span>
								<h3>{step.title}</h3>
								<p>{step.copy}</p>
							</li>
						))}
					</ol>
				</div>
			</section>

			<section class="slice films-cta">
				<div class="films-shell reveal">
					<p class="eyebrow">Private Commissions</p>
					<h2>Have a film in mind?</h2>
					<p>Tell us your idea and timeline. We will reply privately with options, pricing, and availability.</p>
					<a class="btn btn-solid" href="/booking">Book a Consultation</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	// Sections with more than one film: arrows switch films. The film being left is unloaded so it
	// stops playing; the next one loads only when shown (and, for mature films, only in Explicit mode).
	document.querySelectorAll<HTMLElement>('[data-film-switcher]').forEach((box) => {
		const frames = Array.from(box.querySelectorAll<HTMLIFrameElement>('iframe[data-film-slide]'));
		const count = box.querySelector('[data-film-count]');
		const allowed = () => !box.hasAttribute('data-explicit') || document.documentElement.classList.contains('explicit');
		let current = 0;
		const show = (next: number) => {
			const leaving = frames[current];
			const src = leaving.getAttribute('src');
			if (src) {
				leaving.dataset.filmSrc = src;
				leaving.removeAttribute('src');
			}
			leaving.hidden = true;
			current = (next + frames.length) % frames.length;
			const shown = frames[current];
			const url = shown.dataset.filmSrc || shown.dataset.explicitSrc;
			if (url && allowed()) shown.setAttribute('src', url);
			shown.hidden = false;
			if (count) count.textContent = `${current + 1} / ${frames.length}`;
		};
		box.querySelector('[data-film-prev]')?.addEventListener('click', () => show(current - 1));
		box.querySelector('[data-film-next]')?.addEventListener('click', () => show(current + 1));
	});

	// Reveal: sections slide and fade in as they reach the viewport, staggered by data-stagger.
	const revealTargets = document.querySelectorAll<HTMLElement>('.reveal');
	if (reduceMotion || !('IntersectionObserver' in window)) {
		revealTargets.forEach((target) => target.classList.add('is-visible'));
	} else {
		const revealObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting || !(entry.target instanceof HTMLElement)) return;
					const stagger = Number(entry.target.dataset.stagger || 0);
					entry.target.style.transitionDelay = `${stagger * 110}ms`;
					entry.target.classList.add('is-visible');
					revealObserver.unobserve(entry.target);
				});
			},
			{ threshold: 0.15 }
		);
		revealTargets.forEach((target) => revealObserver.observe(target));
	}

	// Parallax: photos drift gently against the scroll.
	const parallaxNodes = Array.from(document.querySelectorAll<HTMLElement>('.parallax'));
	if (!reduceMotion && parallaxNodes.length) {
		const updateParallax = () => {
			const viewportCenter = window.innerHeight * 0.5;
			parallaxNodes.forEach((node) => {
				const rect = node.getBoundingClientRect();
				if (rect.bottom < -200 || rect.top > window.innerHeight + 200) return;
				const distance = rect.top + rect.height * 0.5 - viewportCenter;
				const speed = Number(node.dataset.parallaxSpeed || 0.06);
				node.style.setProperty('--parallax-y', `${(-distance * speed).toFixed(1)}px`);
			});
		};
		let frame = 0;
		const schedule = () => {
			if (frame) return;
			frame = requestAnimationFrame(() => {
				updateParallax();
				frame = 0;
			});
		};
		updateParallax();
		window.addEventListener('scroll', schedule, { passive: true });
		window.addEventListener('resize', schedule);
	}

	// Craft slider arrows.
	const slider = document.querySelector<HTMLElement>('[data-slider]');
	const prev = document.querySelector<HTMLButtonElement>('[data-prev]');
	const next = document.querySelector<HTMLButtonElement>('[data-next]');
	if (slider && prev && next) {
		const step = () => Math.max(280, slider.clientWidth * 0.8);
		const behavior: ScrollBehavior = reduceMotion ? 'auto' : 'smooth';
		prev.addEventListener('click', () => slider.scrollBy({ left: -step(), behavior }));
		next.addEventListener('click', () => slider.scrollBy({ left: step(), behavior }));
	}

	// Section nav: highlight the section currently on screen and keep its chip in view.
	const nav = document.querySelector<HTMLElement>('.section-nav-links');
	const links = new Map(
		Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-section-link]')).map((link) => [link.hash.slice(1), link])
	);
	if (nav && 'IntersectionObserver' in window && links.size) {
		const navObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					links.forEach((link) => link.classList.remove('is-active'));
					const active = links.get(entry.target.id);
					if (!active) return;
					active.classList.add('is-active');
					// Scroll only the chip bar, never the page.
					const left = active.offsetLeft - (nav.clientWidth - active.offsetWidth) / 2;
					nav.scrollTo({ left, behavior: reduceMotion ? 'auto' : 'smooth' });
				});
			},
			{ rootMargin: '-45% 0px -50% 0px' }
		);
		document.querySelectorAll<HTMLElement>('[data-section]').forEach((section) => navObserver.observe(section));
	}
</script>

<style>
	/* Explicit-mode banner: full-width artwork with its own title, buttons underneath. */
	/* The artwork carries its own type and figures: it runs edge to edge at its full 16:9 shape,
	   never cropped (on short screens the title bar sits just below the fold). */
	.films-banner video {
		display: block;
		background: #050505;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: 0;
	}
	/* Computers: the banner leaves room for the section chips and the start of the page below it, so
	   visitors can see there is more to scroll to. The title and buttons sit on the bottom of the video
	   over a dark fade, and the crop favours the top of the frame so heads stay in shot. */
	@media (min-width: 900px) {
		.films-banner {
			position: relative;
		}
		.films-banner video {
			max-height: calc(100svh - var(--header-h, 70px) - 8rem);
			object-position: 50% 15%;
		}
		.films-banner::after {
			content: '';
			position: absolute;
			left: 0;
			right: 0;
			bottom: 0;
			height: 45%;
			background: linear-gradient(to top, rgba(5, 5, 5, 0.92), rgba(5, 5, 5, 0.55) 45%, transparent);
			pointer-events: none;
		}
		.films-banner-bar {
			position: absolute;
			left: 0;
			right: 0;
			bottom: 0;
			z-index: 1;
		}
		.films-banner-bar h1 {
			text-shadow: 0 2px 18px rgba(0, 0, 0, 0.6);
		}
	}
	.films-banner-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		padding-top: 1.4rem;
		padding-bottom: 1.4rem;
	}
	.films-banner-bar h1 {
		margin: 0;
		font-size: clamp(1.4rem, 3vw, 2.1rem);
	}
	.films-banner-bar .hero-actions {
		margin: 0;
	}
	.films {
		padding: 0;
		background: radial-gradient(circle at top, #1b1410 0%, #050505 55%, #020202 100%);
	}
	.films-shell {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 clamp(1rem, 3vw, 2rem);
	}
	.accent {
		position: relative;
		display: inline-block;
		padding-bottom: 10px;
	}
	.accent::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
