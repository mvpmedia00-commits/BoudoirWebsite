						<h2>Step Into The Studio</h2>
						<p>Tell us your concept and ideal timeline. We will respond with a private planning path.</p>
					</div>
					<div class="final-cta-actions">
						<a class="btn btn-solid" href="/booking" data-track data-track-element="home_book_consultation">Begin Your Session</a>
						<a class="btn btn-ghost" href="/gallery" data-track data-track-element="home_view_portfolio">View Portfolio</a>
					</div>
				</section>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	document.addEventListener('click', (event) => {
		const target = event.target;
		if (!(target instanceof HTMLElement)) return;
		const el = target.closest('[data-track]');
		if (!(el instanceof HTMLElement)) return;
		const tracker = window.mvpTrack;
		if (typeof tracker !== 'function') return;
		tracker({
			event_name: 'cta_click',
			page: window.location.pathname,
			element: el.dataset.trackElement || 'unknown',
			niche: el.dataset.trackNiche || '',
			source: 'homepage'
		});
	});

	const heroWall = document.querySelector('.hero-media-wall');
	if (heroWall instanceof HTMLElement) {
		heroWall.classList.add('is-loading');
		const primeVideos = Array.from(heroWall.querySelectorAll<HTMLVideoElement>('video[data-hero-prime]'));
		const deferredVideos = Array.from(heroWall.querySelectorAll<HTMLVideoElement>('video[data-src]'));

		const hydrateVideo = (video: HTMLVideoElement) => {
			if (!(video instanceof HTMLVideoElement)) return;
			if (video.dataset.hydrated === 'true') return;
			const src = video.dataset.src;
			if (!src) return;
			video.src = src;
			video.dataset.hydrated = 'true';
			video.load();
		};

		const hydrateDeferredVideos = () => {
			if (!deferredVideos.length) return;
			let cursor = 0;
			const runBatch = () => {
				const batch = deferredVideos.slice(cursor, cursor + 2);
				batch.forEach((video) => hydrateVideo(video));
				cursor += batch.length;
				if (cursor < deferredVideos.length) {
					window.setTimeout(runBatch, 180);
				}
			};
			const scheduleBatch = () => window.requestAnimationFrame(runBatch);
			if (typeof window.requestIdleCallback === 'function') {
				window.requestIdleCallback(scheduleBatch, { timeout: 1200 });
				return;
			}
			setTimeout(scheduleBatch, 120);
		};

		if (!primeVideos.length) {
			heroWall.classList.remove('is-loading');
			hydrateDeferredVideos();
		} else {
			let pending = primeVideos.length;
			let released = false;
			const release = () => {
				if (released) return;
				released = true;
				heroWall.classList.remove('is-loading');
				window.clearTimeout(timeoutId);
				hydrateDeferredVideos();
			};
			const markReady = () => {
				pending -= 1;
				if (pending <= 0) release();
			};
			const timeoutId = window.setTimeout(release, 2000);

			primeVideos.forEach((video) => {
				if (video.readyState >= 2) {
					markReady();
					return;
				}
				video.addEventListener('loadeddata', markReady, { once: true });
				video.addEventListener('error', markReady, { once: true });
				video.load();
			});
		}
	}
</script>

<style>
	main {
		width: 100%;
		padding-top: 0;
	}
	.homepage {
		background: radial-gradient(circle at top, #1b1410 0%, #050505 55%, #020202 100%);
		position: relative;
	}
	.homepage::before {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			radial-gradient(circle at 20% 0%, rgba(196, 106, 123, 0.22), transparent 55%),
			radial-gradient(circle at 80% 100%, rgba(240, 164, 93, 0.16), transparent 55%);
		mix-blend-mode: soft-light;
	}
	.hero {
		position: relative;
		min-height: 100vh;
		border-bottom: 1px solid var(--stroke);
		overflow: hidden;
		padding: 5.6rem 1rem 2.8rem;
		background: #070707;
	}
	.hero-media-wall {
		position: absolute;
		inset: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.55rem;
		padding: 0.65rem;
		z-index: 0;
	}
	.hero-media-col {
		overflow: hidden;
		border-radius: 14px;
		border: 1px solid rgba(255, 255, 255, 0.08);
		background: rgba(10, 10, 10, 0.82);
	}
	.hero-media-track {
		display: grid;
		gap: 0.5rem;
		padding: 0.5rem;
		animation: hero-vertical 22s linear infinite;
		will-change: transform;
		transform: translateZ(0);
	}
	.hero-media-wall.is-loading .hero-media-track {
		animation-play-state: paused;
	}
	.hero-media-col.reverse .hero-media-track {
		animation-direction: reverse;
	}
	.hero-media-track img,
	.hero-media-track video {
		width: 100%;
		aspect-ratio: 3 / 4;
		object-fit: cover;
		border-radius: 10px;
		border: 1px solid rgba(255, 255, 255, 0.15);
		opacity: 0.85;
	}
	.post-hero-info > section {
		content-visibility: auto;
		contain-intrinsic-size: 760px;
	}
	.hero-noise {
		position: absolute;
		inset: 0;
		opacity: 0.1;
		background-image: radial-gradient(circle, rgba(255, 255, 255, 0.45) 0.8px, transparent 0.8px);
		background-size: 3px 3px;
		pointer-events: none;
		z-index: 1;
	}
	.hero-glow {
		position: absolute;
		width: 44rem;
		height: 44rem;
		filter: blur(70px);
		pointer-events: none;
		border-radius: 999px;
		z-index: 1;
	}
	.hero-glow-left {
		left: -18rem;
		top: -18rem;
		background: rgba(255, 110, 128, 0.24);
	}
	.hero-glow-right {
		right: -16rem;
		bottom: -20rem;
		background: rgba(180, 140, 88, 0.2);
	}
	.hero-content-wrap {
		position: relative;
		z-index: 2;
		width: 100%;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.9rem;
		align-items: center;
	}
	.hero-copy {
		padding: 1.4rem 1.2rem 1.45rem;
		text-align: left;
		max-width: 1080px;
		margin: 0 auto;
		background: linear-gradient(160deg, rgba(7, 7, 7, 0.82), rgba(7, 7, 7, 0.58));
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 6px;
		backdrop-filter: blur(4px);
		box-shadow: 0 20px 70px rgba(0, 0, 0, 0.45);
		position: relative;
	}
	.hero-copy::before {
