---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { SITE_MEDIA } from '../data/siteMedia';

export const prerender = true;

type HeroMediaColumn = {
	reverse?: boolean;
	items: string[];
};

const rawHeroMediaColumns: HeroMediaColumn[] = [
	{
		items: [
			'https://res.cloudinary.com/dg4xwrzu9/video/upload/f_auto,q_auto,w_480,c_fill,vc_auto/v1771778844/grok-video-b1e546eb-43ae-4c20-9334-53847268f6f0_lj5m91.mp4',
			'https://res.cloudinary.com/dg4xwrzu9/video/upload/f_auto,q_auto,w_480,c_fill,vc_auto/v1771783064/grok-video-9235aa62-6fdd-4f45-bd14-ebb3fd08ae08_vrrjjo.mp4',
			'https://res.cloudinary.com/dg4xwrzu9/video/upload/f_auto,q_auto,w_480,c_fill,vc_auto/v1771783074/grok-video-90ae5076-b9d3-4b9b-a7e0-015658114076_1_b0ucez.mp4'
		]
	},
	{
		reverse: true,
		items: [
			'https://res.cloudinary.com/dg4xwrzu9/video/upload/f_auto,q_auto,w_480,c_fill,vc_auto/v1771780425/grok-video-b6dc0a9c-926f-47cd-bd74-288c65925979_xclx4p.mp4',
			'https://res.cloudinary.com/dg4xwrzu9/video/upload/f_auto,q_auto,w_480,c_fill,vc_auto/v1771783064/grok-video-ad3c66dd-7957-4c7b-b49e-afa366007980_fjp7bx.mp4',
			'https://res.cloudinary.com/dg4xwrzu9/video/upload/f_auto,q_auto,w_480,c_fill,vc_auto/v1771780675/grok-video-e37a5a66-37c9-4e0a-9efb-7acdf0e92ed1_mlpgmf.mp4'
		]
	},
	{
		items: [
			'https://res.cloudinary.com/dg4xwrzu9/video/upload/f_auto,q_auto,w_480,c_fill,vc_auto/v1771784294/grok-video-a77ba723-ed82-47fb-a44c-da394706ef53_zsw8ku.mp4',
			'https://res.cloudinary.com/dg4xwrzu9/video/upload/f_auto,q_auto,w_480,c_fill,vc_auto/v1771788759/grok-video-98796eaa-50b7-43b8-ad25-7712f95fefb7_1_b29nwo.mp4',
			'https://res.cloudinary.com/dg4xwrzu9/video/upload/f_auto,q_auto,w_480,c_fill,vc_auto/v1771789682/grok-video-615b8d45-bf96-464e-a1ec-9af35c32e448_1_zc25xe.mp4'
		]
	},
	{
		reverse: true,
		items: [
			'https://res.cloudinary.com/dg4xwrzu9/video/upload/f_auto,q_auto,w_480,c_fill,vc_auto/v1771778842/grok-video-7f5538a0-9516-462e-bc15-c1ff8d65729d_ja5w2s.mp4',
			'https://res.cloudinary.com/dg4xwrzu9/video/upload/f_auto,q_auto,w_480,c_fill,vc_auto/v1771788591/grok-video-27858631-03b8-406f-bde2-16ea3742d393_nqtvab.mp4',
			'https://res.cloudinary.com/dg4xwrzu9/video/upload/f_auto,q_auto,w_480,c_fill,vc_auto/v1771789106/grok-video-9564afee-04d3-4d2a-af37-8fd002e6a40e_nejhyj.mp4'
		]
	}
];

const heroMediaColumns = rawHeroMediaColumns.map((column) => ({
	...column,
	items: [...column.items, ...column.items]
}));

const getVideoPoster = (src: string) => src.replace(',vc_auto', '').replace('.mp4', '.jpg');

const homeSchema = {
	'@context': 'https://schema.org',
	// ...add schema properties here...
};
// ...existing code...
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
		<link rel="preload" as="image" href={getVideoPoster(heroMediaColumns[0].items[0])} />
		<script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />
	</head>
	<body>
		<Header />
		<main class="homepage">
			<section class="hero">
				<div class="hero-media-wall" aria-hidden="true">
					{
						heroMediaColumns.map((column) => (
							<div class:list={['hero-media-col', { reverse: column.reverse }]}>
								<div class="hero-media-track">
									{
										column.items.map((src, index) => {
											const isPrime = index === 0;
											const isDeferred = !isPrime;
											return (
												<video
													src={isDeferred ? undefined : src}
													data-src={isDeferred ? src : undefined}
													autoplay
													muted
													loop
													playsinline
													preload={isPrime ? 'metadata' : 'none'}
													poster={getVideoPoster(src)}
													data-hero-prime={isPrime ? 'true' : undefined}
													aria-hidden={index >= 3 ? 'true' : undefined}
												></video>
											);
										})
									}
								</div>
							</div>
						))
					}
				</div>
				<div class="hero-noise"></div>
				<div class="hero-glow hero-glow-left"></div>
				<div class="hero-glow hero-glow-right"></div>

				<div class="hero-content-wrap">
					<div class="hero-copy">
						<p class="hero-kicker">Private Studio Sessions</p>
						<p class="hero-strap">Luxury Boudoir Direction</p>
						<p class="hero-location">New York and Destination Commissions</p>

						<div class="hero-title-video-box">
							<img class="hero-title-video" src={SITE_MEDIA.about} alt="" loading="eager" decoding="async" fetchpriority="high" />
							<div class="hero-title-overlay"></div>
							<h1>Bold. Intimate. Cinematic.</h1>
						</div>

						<p class="hero-sub">
							Curated photo and film sessions for clients who want elevated visuals, private production, and timeless storytelling.
						</p>
						<div class="hero-divider"></div>
						<div class="hero-actions">
							<a class="btn btn-solid" href="/booking" data-track data-track-element="hero_book_session">Book Session</a>
							<a class="btn btn-ghost" href="/gallery" data-track data-track-element="hero_view_gallery">View Gallery</a>
						</div>
						<div class="hero-meta">
