				</div>
			</section>

			<section class="post-hero-info">
				<section class="category-preview section--warm fade-up">
					<div class="section-head">
						<p class="section-kicker">Portfolio</p>
						<h2 class="heading-accent">Choose Your Category</h2>
					</div>
					<div class="category-grid">
						<a class="category-card" href="/gallery/boudoir" data-track data-track-element="home_category_boudoir">
							<div class="art-frame">
								<img src={SITE_MEDIA.three} alt="Boudoir category preview" loading="lazy" />
							</div>
							<div class="category-copy">
								<h3>Boudoir</h3>
								<p>Private sessions with intentional direction and discreet delivery.</p>
							</div>
						</a>
						<a class="category-card" href="/gallery/artistic-nude" data-track data-track-element="home_category_artistic_nude">
							<div class="art-frame">
								<img src={SITE_MEDIA.four} alt="Artistic nude category preview" loading="lazy" />
							</div>
							<div class="category-copy">
								<h3>Artistic Nude</h3>
								<p>Fine-art portraiture built around composition, form, and cinematic mood.</p>
							</div>
						</a>
						<a class="category-card" href="/gallery/body-paint" data-track data-track-element="home_category_body_paint">
							<div class="art-frame">
								<img src={SITE_MEDIA.one} alt="Body paint category preview" loading="lazy" />
							</div>
							<div class="category-copy">
								<h3>Body Paint</h3>
								<p>Creative body-art concepts with styling and editorial production value.</p>
							</div>
						</a>
						<a class="category-card" href="/gallery/editorial-portrait" data-track data-track-element="home_category_editorial_portrait">
							<div class="art-frame">
								<img src={SITE_MEDIA.five} alt="Editorial portrait category preview" loading="lazy" />
							</div>
							<div class="category-copy">
								<h3>Editorial Portrait</h3>
								<p>Brand-safe portrait sessions for campaigns, lookbooks, and lifestyle stories.</p>
							</div>
