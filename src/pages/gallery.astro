---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { GALLERY_CATEGORIES } from '../data/galleryMedia';
import { PORTFOLIO_PHOTOS, SITE_MEDIA } from '../data/siteMedia';

const categoryVisuals = {
	boudoir: {
		image: PORTFOLIO_PHOTOS.boudoir[0],
		veil: true,
		mood: 'Warm editorial silhouettes and confident direction.'
	},
	'artistic-nude': {
		image: PORTFOLIO_PHOTOS.artisticNude[0],
		veil: true,
		mood: 'Fine-art composition focused on form, light, and shape.'
	},
	'body-paint': {
		image: SITE_MEDIA.one,
		mood: 'Color-washed texture and body-art storytelling.'
	},
	'editorial-portrait': {
		image: SITE_MEDIA.five,
		mood: 'Brand-safe portraiture with cinematic styling and polish.'
	}
} as const;

const featuredStrip = [SITE_MEDIA.one, SITE_MEDIA.two, SITE_MEDIA.three, SITE_MEDIA.four, SITE_MEDIA.five, SITE_MEDIA.about];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Gallery | ${SITE_TITLE}`}
			description="Explore boudoir, artistic nude, body paint, and editorial portrait portfolio categories."
		/>
	</head>
	<body>
		<Header />
		<main class="gallery-index">
			<section class="gallery-atmosphere">
				<img class="atmosphere-still" src={SITE_MEDIA.about} alt="" loading="eager" />
				<div class="gallery-atmosphere-overlay"></div>
				<div class="gallery-lead fade-up">
					<p class="eyebrow">Portfolio</p>
					<h1>Every body tells a story.</h1>
					<p>
						Cinematic boudoir, artistic nude, body-paint, and editorial portrait collections with discreet direction and premium
						visual finish.
					</p>
					<p class="lead-note">Categories marked 18+ ask you to confirm your age before viewing.</p>
				</div>
			</section>

			<section class="gallery-grid fade-up">
				{GALLERY_CATEGORIES.map((category) => (
					<a class="category-card" href={`/gallery/${category.slug}`}>
						<div class="category-media" data-veil={'veil' in categoryVisuals[category.slug] ? '' : undefined}>
							<img src={categoryVisuals[category.slug].image} alt={`${category.label} portfolio preview`} loading="lazy" />
							<div class="category-wash"></div>
						</div>
						<div class="category-content">
							<p class="card-kicker">{category.sensitive ? '18+' : 'All audiences'}</p>
							<h2>{category.label}</h2>
							<p>{category.description}</p>
							<p class="category-mood">{categoryVisuals[category.slug].mood}</p>
							<span>Open Gallery</span>
						</div>
					</a>
				))}
			</section>

			<section class="featured-strip fade-up" aria-label="Featured Work Preview">
				<div class="featured-track">
					{featuredStrip.map((src) => <img src={src} alt="" loading="lazy" />)}
					{featuredStrip.map((src) => <img src={src} alt="" loading="lazy" />)}
				</div>
			</section>

			<section class="creator-reassurance fade-up">
				<p class="eyebrow">Your Session</p>
				<h2>Private, guided, and yours</h2>
				<div class="reassurance-grid">
					<article>
						<h3>Your Images, Your Control</h3>
						<p>Publication permissions stay in your hands with clear boundaries and documented usage.</p>
					</article>
					<article>
						<h3>Private Delivery</h3>
						<p>Your final gallery is delivered privately, with sizes ready for print, web, and social.</p>
					</article>
					<article>
						<h3>Creative Direction</h3>
						<p>Guided posing and styling at a pace that keeps you comfortable throughout.</p>
					</article>
				</div>
			</section>

			<section class="category-cta fade-up">
				<h2>Step into the studio</h2>
				<p>Every session starts with a private consultation and a concept built around you.</p>
				<a class="btn btn-solid" href="/booking">Book a Consultation</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.gallery-index {
		padding: 0 1rem 3rem;
		background: radial-gradient(circle at top, #1b1410 0%, #050505 55%, #020202 100%);
		position: relative;
	}
	.gallery-index::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at 20% 0%, rgba(196, 106, 123, 0.23), transparent 55%),
			radial-gradient(circle at 80% 100%, rgba(240, 164, 93, 0.16), transparent 55%);
		mix-blend-mode: soft-light;
		pointer-events: none;
	}
	.gallery-atmosphere {
		position: relative;
		margin: 0 -1rem 1.2rem;
		min-height: 44vh;
		display: grid;
		align-items: end;
		background: linear-gradient(140deg, rgba(17, 10, 10, 0.6), rgba(7, 7, 7, 0.88));
		overflow: hidden;
	}
	.atmosphere-still {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		filter: saturate(1.04) contrast(1.03);
	}
	.gallery-atmosphere-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(170deg, rgba(196, 106, 123, 0.2), rgba(6, 6, 6, 0.72));
	}
	.gallery-lead {
		position: relative;
		z-index: 1;
		max-width: 860px;
		margin: 0 auto;
		padding: 3.8rem 1rem 1.4rem;
	}
	.gallery-lead h1 {
		font-size: clamp(2rem, 6vw, 4rem);
		margin: 0.2rem 0 0.5rem;
		max-width: 18ch;
	}
	.gallery-lead p {
		color: #d4cbc6;
	}
	.gallery-lead .lead-note {
		margin-top: 0.2rem;
		font-size: 0.8rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #d5be96;
	}
	.gallery-grid {
		position: relative;
		z-index: 1;
		max-width: 1220px;
		margin: 0 auto 1.8rem;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
	}
	.category-card {
		background: #131313;
		border: 1px solid rgba(213, 190, 150, 0.22);
		text-decoration: none;
		color: #e5e5e5;
		display: grid;
		grid-template-columns: 1fr;
		overflow: hidden;
	}
	.category-media {
		position: relative;
		overflow: hidden;
	}
	.category-media {
		aspect-ratio: 4 / 5;
	}
	.category-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		transition: transform 360ms ease;
	}
	.category-wash {
		position: absolute;
		inset: 0;
		/* A faint shade at the bottom edge only; photos are shown in their true colors. */
		background: linear-gradient(180deg, transparent 65%, rgba(9, 9, 9, 0.35));
		opacity: 1;
		transition: opacity 280ms ease;
	}
	.category-content {
		display: grid;
		gap: 0.45rem;
		padding: 0.95rem;
	}
	.category-card h2 {
		margin: 0;
		font-family: 'Cormorant Garamond', 'Times New Roman', serif;
		font-size: clamp(1.5rem, 3vw, 2.2rem);
		color: #d5be96;
	}
	.category-card p {
		margin: 0;
		line-height: 1.55;
		color: #bdbdbd;
	}
	.category-card .card-kicker {
		font-size: 0.65rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #d5be96;
	}
	.category-card .category-mood {
		font-size: 0.82rem;
		color: #c4b6af;
	}
	.category-card span {
		font-size: 0.73rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #f6f6f6;
		transform: translateY(4px);
		opacity: 0.84;
		transition: transform 220ms ease, opacity 220ms ease;
	}
	.category-card:hover {
		border-color: rgba(213, 190, 150, 0.46);
		background: #1a1a1a;
	}
	.category-card:hover .category-media img {
		transform: scale(1.04);
	}
	.category-card:hover .category-wash {
		opacity: 0.65;
	}
	.category-card:hover span {
		transform: translateY(0);
		opacity: 1;
	}
	.featured-strip {
		position: relative;
		z-index: 1;
		max-width: 1220px;
		margin: 0 auto 1.7rem;
		overflow: hidden;
		border: 1px solid rgba(213, 190, 150, 0.2);
		background: #101010;
	}
	.featured-track {
		display: flex;
		gap: 0.55rem;
		width: max-content;
		padding: 0.55rem;
		animation: featured-scroll 26s linear infinite;
	}
	.featured-track img {
		width: 160px;
		height: 200px;
		object-fit: cover;
		border-radius: 10px;
		border: 1px solid rgba(255, 255, 255, 0.14);
	}
	.creator-reassurance {
		position: relative;
		z-index: 1;
		max-width: 1220px;
		margin: 0 auto 1.8rem;
		padding: 1.15rem 1rem;
		border: 1px solid rgba(196, 106, 123, 0.24);
		background: linear-gradient(135deg, #2a1518 0%, #0c0c0c 100%);
	}
	.creator-reassurance h2 {
		margin: 0;
		font-family: 'Cormorant Garamond', 'Times New Roman', serif;
		font-size: clamp(1.5rem, 3.4vw, 2.55rem);
		color: #f2ddda;
	}
	.reassurance-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.8rem;
		margin-top: 0.9rem;
	}
	.reassurance-grid article {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.1);
		padding: 0.85rem;
	}
	.reassurance-grid h3 {
		margin: 0 0 0.45rem;
		font-family: 'Cormorant Garamond', 'Times New Roman', serif;
		color: #f0d5be;
		font-size: 1.2rem;
	}
	.reassurance-grid p {
		margin: 0;
		color: #ccb8b5;
		font-size: 0.84rem;
		line-height: 1.6;
	}
	.category-cta {
		position: relative;
		z-index: 1;
		max-width: 1220px;
		margin: 0 auto;
		padding: 1.4rem 1rem;
		border: 1px solid rgba(213, 190, 150, 0.28);
		background: linear-gradient(145deg, rgba(18, 18, 18, 0.94), rgba(10, 10, 10, 0.96));
	}
	.category-cta h2 {
		margin: 0;
		font-family: 'Cormorant Garamond', 'Times New Roman', serif;
		font-size: clamp(1.6rem, 3.4vw, 2.6rem);
		color: #d5be96;
	}
	.category-cta p {
		margin: 0.5rem 0 0.8rem;
		color: #b9b9b9;
		max-width: 68ch;
	}
	.fade-up {
		opacity: 0;
		transform: translateY(20px);
		animation: gallery-fade-up 0.8s ease forwards;
	}
	.gallery-grid.fade-up {
		animation-delay: 120ms;
	}
	.featured-strip.fade-up {
		animation-delay: 200ms;
	}
	.creator-reassurance.fade-up {
		animation-delay: 280ms;
	}
	.category-cta.fade-up {
		animation-delay: 360ms;
	}
	@media (max-width: 760px) {
		.gallery-atmosphere {
			min-height: 38vh;
		}
		.gallery-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.75rem;
		}
		.reassurance-grid {
			grid-template-columns: 1fr;
		}
		.featured-track img {
			width: 128px;
			height: 160px;
		}
	}
	@media (min-width: 761px) and (max-width: 1100px) {
		.gallery-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 420px) {
		.gallery-grid {
			grid-template-columns: 1fr;
		}
	}
	@keyframes featured-scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}
	@keyframes gallery-fade-up {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
