---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const publishedPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const categories = Array.from(new Set(publishedPosts.map((post) => post.data.category)));
const recentTags = Array.from(new Set(publishedPosts.flatMap((post) => post.data.tags))).slice(0, 18);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Journal | ${SITE_TITLE}`}
			description="The MVP Media journal: session preparation, privacy, and creative direction for boudoir and fine art portraiture."
		/>
		<style>
			.blog-layout {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 290px;
				gap: 1.2rem;
			}
			.blog-layout.is-empty {
				grid-template-columns: minmax(0, 1fr);
				max-width: 820px;
				margin: 0 auto;
			}
			.empty-state {
				padding: 1.6rem;
				border: 1px solid var(--stroke);
				border-radius: var(--radius);
				background: linear-gradient(145deg, var(--surface), var(--surface-elevated));
			}
			.blog-main {
				display: grid;
				gap: 0.9rem;
			}
			.blog-intro,
			.post-row,
			.blog-sidebar {
				background: linear-gradient(145deg, var(--surface), var(--surface-elevated));
				border: 1px solid var(--stroke);
				border-radius: var(--radius);
			}
			.blog-intro {
				padding: 1.1rem;
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				gap: 0.8rem;
			}
			.post-row {
				padding: 1rem;
				display: grid;
				gap: 0.6rem;
			}
			.post-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.55rem;
				font-size: 0.74rem;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: var(--text-muted);
			}
			.post-row h2 {
				margin: 0;
				font-size: 1.2rem;
			}
			.post-row h2 a {
				text-decoration: none;
				color: var(--text-primary);
			}
			.post-row h2 a:hover {
				color: var(--brand-strong);
			}
			.post-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem;
			}
			.post-tags a {
				text-decoration: none;
				font-size: 0.72rem;
				padding: 0.22rem 0.5rem;
				border-radius: 999px;
				border: 1px solid var(--stroke);
				color: var(--text-muted);
			}
			.post-tags a:hover {
				color: var(--text-primary);
				background: rgba(157, 135, 95, 0.2);
			}
			.read-link {
				width: fit-content;
				text-decoration: none;
				font-weight: 700;
			}
			.blog-sidebar {
				position: sticky;
				top: 5.4rem;
				height: fit-content;
				padding: 0.95rem;
				display: grid;
				gap: 0.95rem;
			}
			.blog-sidebar h3 {
				font-size: 0.86rem;
				text-transform: uppercase;
				letter-spacing: 0.07em;
				margin: 0;
				color: var(--text-muted);
			}
			.blog-sidebar ul {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				gap: 0.35rem;
			}
			.blog-sidebar a {
				text-decoration: none;
			}
			@media (max-width: 980px) {
				.blog-layout {
					grid-template-columns: 1fr;
				}
				.blog-sidebar {
					position: static;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class:list={['blog-layout', { 'is-empty': publishedPosts.length === 0 }]}>
				<div class="blog-main">
					<div class="blog-intro">
						<p class="eyebrow">Journal</p>
						<h1>Notes from the studio</h1>
						<p>Session preparation, privacy, and creative direction for boudoir and fine art portraiture.</p>
					</div>
					{publishedPosts.length === 0 && (
						<div class="empty-state">
							<p>The first journal entries are on their way. In the meantime, explore the portfolio or get in touch.</p>
							<div class="hero-actions">
								<a class="btn btn-solid" href="/gallery">View Portfolio</a>
								<a class="btn btn-ghost" href="/booking">Book a Consultation</a>
							</div>
						</div>
					)}
					<ul class="post-list">
						{
							publishedPosts.map((post) => (
								<li class="post-row">
									<div class="post-meta">
										<span>{post.data.featured ? 'Featured' : 'Article'}</span>
										<span>{post.data.category.replaceAll('-', ' ')}</span>
										<span><FormattedDate date={post.data.pubDate} /></span>
									</div>
									<h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
									<p>{post.data.description}</p>
									<div class="post-tags">
										{post.data.tags.map((tag) => <a href={`/blog/tag/${tag.toLowerCase()}/`}>#{tag}</a>)}
									</div>
									<a class="read-link" href={`/blog/${post.id}/`}>Read article</a>
								</li>
							))
						}
					</ul>
				</div>
				{publishedPosts.length > 0 && <aside class="blog-sidebar">
					<div>
						<h3>Categories</h3>
						<ul>
							{categories.map((category) => <li><a href={`/blog/category/${category}/`}>{category.replaceAll('-', ' ')}</a></li>)}
						</ul>
					</div>
					<div>
						<h3>Tags</h3>
						<ul>
							{recentTags.map((tag) => <li><a href={`/blog/tag/${tag.toLowerCase()}/`}>#{tag}</a></li>)}
						</ul>
					</div>
					<div>
						<h3>Feed</h3>
						<p><a href="/rss.xml">Subscribe via RSS</a></p>
					</div>
				</aside>}
			</section>
		</main>
		<Footer />
	</body>
</html>
