---
import { getEntry, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ProductCover from '../../components/store/ProductCover.astro';
import { SITE_MEDIA } from '../../data/siteMedia';
import { SITE_TITLE } from '../../consts';
import { hasAdultAccess } from '../../lib/access';
import { buyableOptions, priceNumber } from '../../lib/store';

const item = Astro.params.slug ? await getEntry('store', Astro.params.slug) : undefined;
if (!item || item.data.status === 'hidden') {
	return Astro.redirect('/store');
}

const { data } = item;
const isAllowed = !data.mature || hasAdultAccess(Astro.cookies);
const { Content } = await render(item);
const buyable = buyableOptions(item);
const images = [data.image, ...data.gallery].filter((src): src is string => Boolean(src));
const pageTitle = [data.title, data.subtitle].filter(Boolean).join(', ');
const previewPages = data.preview;

const productSchema = {
	'@context': 'https://schema.org',
	'@type': 'Product',
	name: pageTitle,
	description: data.summary,
	...(images[0] ? { image: images[0] } : {}),
	brand: { '@type': 'Brand', name: SITE_TITLE },
	offers: buyable
		.filter((option) => priceNumber(option.price))
		.map((option) => ({
			'@type': 'Offer',
			name: option.label,
			price: priceNumber(option.price),
			priceCurrency: 'USD',
			url: option.url,
			availability: 'https://schema.org/InStock'
		}))
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${pageTitle} | ${SITE_TITLE}`}
			description={data.summary}
			image={isAllowed && images[0] ? images[0] : SITE_MEDIA.one}
			noIndex={data.mature}
			jsonLd={isAllowed ? productSchema : null}
		/>
	</head>
	<body>
		<Header />
		<main class="product-page">
			<p class="crumb"><a href="/store">Store</a> / {data.category}</p>
			{
				isAllowed ? (
					<>
						<section class="product">
							<div class="media">
								<div data-main-cover>
									<ProductCover title={data.title} subtitle={data.subtitle} image={images[0]} eager />
								</div>
								{images.length > 1 && (
									<div class="thumbs" role="list">
										{images.map((src, index) => (
											<button
												type="button"
												role="listitem"
												class:list={['thumb', { 'is-active': index === 0 }]}
												data-thumb={src}
												aria-label={`Show image ${index + 1}`}
											>
												<img src={src} alt="" loading="lazy" decoding="async" />
											</button>
										))}
									</div>
								)}
							</div>

							<div class="info">
								<p class="eyebrow">{data.category}</p>
								<h1>{data.title}</h1>
								{data.subtitle && <p class="subtitle">{data.subtitle}</p>}
								<p class="summary">{data.summary}</p>
								{previewPages.length > 0 && (
									<a class="btn btn-ghost look-link" href="#look-inside">Look inside</a>
								)}

								{data.options.length > 0 && (
									<div class="options">
										{data.options.map((option) => {
											const canBuy = data.status === 'available' && option.url;
											return (
												<div class="option">
													<div class="option-head">
														<h2>{option.label}</h2>
														{option.price && <span class="price">{option.price}</span>}
													</div>
													{option.note && <p class="note">{option.note}</p>}
													{canBuy ? (
														<a class="btn btn-solid" href={option.url} target="_blank" rel="noopener noreferrer">
															Buy {option.label}
															<span class="sr-only"> (opens in a new tab)</span>
														</a>
													) : (
														<span class="soon">Coming soon</span>
													)}
												</div>
											);
										})}
									</div>
								)}

								{buyable.length > 0 ? (
									<p class="seller">
										{data.seller
											? `Sold and delivered by ${data.seller}. You will complete your purchase on their site.`
											: 'You will complete your purchase on our store partner’s site.'}
									</p>
								) : (
									<p class="seller">
										Not available to buy yet. <a href="mailto:hello@mvpmedia.studio?subject=Store%20inquiry">Email us</a> to hear when it is.
									</p>
								)}
							</div>
						</section>

						{previewPages.length > 0 && (
							<section class="look-inside" id="look-inside" aria-labelledby="look-inside-title">
								<div class="look-head">
									<p class="eyebrow">Preview</p>
									<h2 id="look-inside-title">Look inside</h2>
									<p>A few pages from this issue. Select a page to read it full size.</p>
								</div>
								<ol class="pages">
									{previewPages.map((page, index) => (
										<li class="preview-page" data-page-item>
											<button
												type="button"
												data-page-src={page.src}
												data-page-caption={page.caption ?? ''}
												aria-label={`Read ${page.caption ?? `page ${index + 1}`}`}
											>
												<img
													src={page.src}
													alt=""
													loading="lazy"
													decoding="async"
													width="816"
													height="1056"
													onerror="this.closest('[data-page-item]').remove()"
												/>
											</button>
											{page.caption && <span class="page-caption">{page.caption}</span>}
										</li>
									))}
								</ol>
							</section>
						)}

						<section class="details">
							<Content />
						</section>

						<p class="back"><a href="/store">&larr; Back to the store</a></p>
					</>
				) : (
					<section class="gate">
						<p class="eyebrow">18+ Only</p>
						<h1>{data.title}</h1>
						<p>This item contains artistic nudity and is intended for adults. Please confirm you are 18 or older to continue.</p>
						<a class="btn btn-solid" href={`/api/adult-access?returnTo=/store/${item.id}`}>I am 18 or older</a>
						<a class="btn btn-ghost" href="/store">Back to the store</a>
					</section>
				)
			}
		</main>
		<Footer />
		{isAllowed && previewPages.length > 0 && (
			<dialog class="reader" data-reader aria-label={`${data.title} preview`}>
				<div class="reader-bar">
					<p><span data-reader-count></span> <span class="reader-caption" data-reader-caption></span></p>
					<button type="button" class="reader-close" data-reader-close>Close</button>
				</div>
				<div class="reader-stage">
					<button type="button" class="reader-nav" data-reader-prev aria-label="Previous page">&larr;</button>
					<img data-reader-img alt="" width="816" height="1056" />
					<button type="button" class="reader-nav" data-reader-next aria-label="Next page">&rarr;</button>
				</div>
			</dialog>
		)}
	</body>
</html>

<script>
	// Gallery: clicking a thumbnail swaps the main image.
	const main = document.querySelector<HTMLImageElement>('[data-main-cover] img');
	const thumbs = document.querySelectorAll<HTMLButtonElement>('[data-thumb]');
	thumbs.forEach((thumb) => {
		thumb.addEventListener('click', () => {
			if (!main || !thumb.dataset.thumb) return;
			main.src = thumb.dataset.thumb;
			thumbs.forEach((other) => other.classList.toggle('is-active', other === thumb));
		});
	});

	// Look inside: a page reader with arrow keys, swipe, and prev/next buttons.
	const reader = document.querySelector<HTMLDialogElement>('[data-reader]');
	if (reader) {
		const img = reader.querySelector<HTMLImageElement>('[data-reader-img]')!;
		const count = reader.querySelector<HTMLElement>('[data-reader-count]')!;
		const caption = reader.querySelector<HTMLElement>('[data-reader-caption]')!;
		const prev = reader.querySelector<HTMLButtonElement>('[data-reader-prev]')!;
		const next = reader.querySelector<HTMLButtonElement>('[data-reader-next]')!;
		// Read the list each time: pages whose image failed to load have been removed.
		const pages = () => Array.from(document.querySelectorAll<HTMLButtonElement>('[data-page-src]'));
		let current = 0;
		let opener: HTMLElement | null = null;

		const show = (index: number) => {
			const list = pages();
			if (!list.length) return reader.close();
			current = (index + list.length) % list.length;
			const page = list[current];
			img.src = page.dataset.pageSrc ?? '';
			img.alt = page.dataset.pageCaption || `Page ${current + 1}`;
			count.textContent = `${current + 1} / ${list.length}`;
			caption.textContent = page.dataset.pageCaption ?? '';
			prev.hidden = next.hidden = list.length < 2;
		};

		document.addEventListener('click', (event) => {
			const page = (event.target as Element).closest<HTMLButtonElement>('[data-page-src]');
			if (!page) return;
			opener = page;
			show(pages().indexOf(page));
			reader.showModal();
		});
		prev.addEventListener('click', () => show(current - 1));
		next.addEventListener('click', () => show(current + 1));
		reader.querySelector('[data-reader-close]')?.addEventListener('click', () => reader.close());
		// Clicking the dark area around the page closes the reader.
		reader.addEventListener('click', (event) => {
			if (event.target === reader) reader.close();
		});
		reader.addEventListener('close', () => opener?.focus());
		reader.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') show(current - 1);
			if (event.key === 'ArrowRight') show(current + 1);
		});
		let touchX = 0;
		reader.addEventListener('touchstart', (event) => (touchX = event.touches[0].clientX), { passive: true });
		reader.addEventListener('touchend', (event) => {
			const dx = event.changedTouches[0].clientX - touchX;
			if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
		});
	}
</script>

<style>
	.product-page {
		max-width: 1200px;
		margin: 0 auto;
		padding-top: clamp(1.5rem, 4vw, 3rem);
	}
	.crumb {
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		margin-bottom: 1.5rem;
	}
	.crumb a {
		text-decoration: none;
	}
	.product {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
	}
	.media {
		position: sticky;
		top: calc(var(--header-h, 70px) + 1.5rem);
		display: grid;
		gap: 0.75rem;
	}
	.thumbs {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(70px, 1fr));
		gap: 0.5rem;
	}
	.thumb {
		padding: 0;
		border: 1px solid var(--stroke);
		border-radius: 8px;
		overflow: hidden;
		background: none;
		cursor: pointer;
		aspect-ratio: 4 / 5;
		opacity: 0.6;
		transition: opacity 0.2s ease, border-color 0.2s ease;
	}
	.thumb.is-active,
	.thumb:hover {
		opacity: 1;
		border-color: var(--brand-strong);
	}
	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
	}
	.info h1 {
		font-size: clamp(2.3rem, 5vw, 3.6rem);
		margin-bottom: 0.3rem;
	}
	.subtitle {
		color: var(--brand-strong);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		font-size: 0.8rem;
	}
	.summary {
		font-size: 1.08rem;
		color: #d8d2cb;
	}
	.options {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
		gap: 1rem;
		margin-top: 1.75rem;
	}
	.option {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1.3rem;
		border: 1px solid var(--stroke);
		border-radius: var(--radius);
		background: linear-gradient(145deg, var(--surface), var(--surface-elevated));
	}
	.option-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}
	.option h2 {
		margin: 0;
		font-size: 1.45rem;
	}
	.price {
		color: var(--text-primary);
		font-weight: 700;
		font-size: 1.15rem;
	}
	.note {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.6;
	}
	.option .btn,
	.soon {
		margin-top: auto;
		text-align: center;
	}
	.soon {
		display: block;
		padding: 0.73rem 1.15rem;
		border: 1px dashed var(--stroke);
		border-radius: 999px;
		color: var(--text-muted);
		font-size: 0.78rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.seller {
		margin-top: 1rem;
		font-size: 0.88rem;
	}
	.look-link {
		width: fit-content;
		margin-top: 0.5rem;
	}
	.look-inside {
		margin-top: clamp(2.5rem, 6vw, 4rem);
		padding-top: 2rem;
		border-top: 1px solid var(--stroke);
		scroll-margin-top: calc(var(--header-h, 70px) + 1rem);
	}
	/* Hide the section if none of the pages could load. */
	.look-inside:not(:has(.preview-page)) {
		display: none;
	}
	.look-head h2 {
		margin: 0 0 0.4rem;
		font-size: clamp(1.8rem, 4vw, 2.6rem);
	}
	.look-head p:last-child {
		margin: 0;
	}
	.pages {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: clamp(150px, 22vw, 220px);
		gap: 1rem;
		margin: 1.5rem 0 0;
		padding: 0 0 1rem;
		list-style: none;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		overscroll-behavior-x: contain;
	}
	.preview-page {
		display: grid;
		align-content: start;
		gap: 0.55rem;
		scroll-snap-align: start;
	}
	.preview-page button {
		padding: 0;
		border: 1px solid var(--stroke);
		border-radius: 6px;
		overflow: hidden;
		background: var(--surface);
		cursor: zoom-in;
		aspect-ratio: 816 / 1056;
		transition: border-color 0.2s ease, transform 0.3s ease;
	}
	.preview-page button:hover,
	.preview-page button:focus-visible {
		border-color: var(--brand-strong);
		transform: translateY(-3px);
	}
	.preview-page img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center;
		border-radius: 0;
	}
	.page-caption {
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	.reader {
		width: 100vw;
		max-width: 100vw;
		height: 100dvh;
		max-height: 100dvh;
		margin: 0;
		padding: 0;
		border: 0;
		background: rgba(5, 5, 5, 0.97);
		color: var(--text-primary);
	}
	.reader[open] {
		display: grid;
		grid-template-rows: auto minmax(0, 1fr);
	}
	.reader::backdrop {
		background: rgba(0, 0, 0, 0.7);
	}
	.reader-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.9rem clamp(1rem, 3vw, 2rem);
		font-size: 0.82rem;
		letter-spacing: 0.08em;
	}
	.reader-bar p {
		margin: 0;
	}
	.reader-caption {
		color: var(--text-muted);
		margin-left: 0.6rem;
	}
	.reader-close,
	.reader-nav {
		background: rgba(20, 20, 20, 0.8);
		color: var(--text-primary);
		border: 1px solid var(--stroke);
		border-radius: 999px;
		font: inherit;
		cursor: pointer;
	}
	.reader-close {
		padding: 0.5rem 1rem;
		font-size: 0.78rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.reader-stage {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 0;
		padding: 0 clamp(0.5rem, 2vw, 1.5rem) clamp(0.5rem, 2vw, 1.5rem);
	}
	.reader-stage img {
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		object-fit: contain;
		border-radius: 4px;
		box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6);
	}
	.reader-nav {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		width: 3rem;
		height: 3rem;
		font-size: 1.2rem;
	}
	.reader-nav[data-reader-prev] {
		left: clamp(0.5rem, 2vw, 1.5rem);
	}
	.reader-nav[data-reader-next] {
		right: clamp(0.5rem, 2vw, 1.5rem);
	}
	.reader-nav:hover {
		border-color: var(--brand-strong);
	}
	.details {
		max-width: 70ch;
		margin-top: clamp(2.5rem, 6vw, 4rem);
		padding-top: 2rem;
		border-top: 1px solid var(--stroke);
	}
	.details :global(p) {
		color: #cfc7bf;
	}
	.back {
		margin-top: 2.5rem;
	}
	.gate .btn {
		width: fit-content;
	}
	@media (max-width: 860px) {
		.product {
			grid-template-columns: 1fr;
		}
		.media {
			position: static;
			max-width: 440px;
		}
	}
</style>
