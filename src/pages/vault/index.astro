---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const vaultCode = String(import.meta.env.PUBLIC_VAULT_CODE ?? 'mvp-after-dark');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Members Vault | MVP Media"
			description="Private member access for protected portfolio collections and client-only drops."
			noIndex={true}
		/>
		<style>
			.vault-entry {
				max-width: 640px;
				margin: 0 auto;
				padding: 1.4rem;
				background: linear-gradient(145deg, var(--surface), var(--surface-elevated));
				border: 1px solid var(--stroke);
				border-radius: var(--radius);
			}
			form {
				display: grid;
				gap: 0.8rem;
			}
			input {
				width: 100%;
				padding: 0.8rem;
				border-radius: 10px;
				border: 1px solid var(--stroke);
				background: rgba(255, 255, 255, 0.03);
				color: var(--text-primary);
			}
			.entry-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
			}
			.error {
				color: #ef8f8f;
				min-height: 1rem;
				margin: 0;
				font-size: 0.85rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="vault-entry">
				<p class="eyebrow">Private Access</p>
				<h1>Members Vault</h1>
				<p>Enter your passcode to unlock private collections and member-only editorial drops.</p>
				<form id="vault-access-form" data-vault-code={vaultCode}>
					<label for="vault-code">Access Code</label>
					<input id="vault-code" name="vault-code" type="password" required autocomplete="off" />
					<p id="vault-error" class="error"></p>
					<div class="entry-actions">
						<button type="submit" class="btn btn-solid">Unlock Vault</button>
						<a class="btn btn-ghost" href="/">Return Home</a>
					</div>
				</form>
			</section>
		</main>
		<Footer />
		<script is:inline>
			const form = document.getElementById('vault-access-form');
			const errorEl = document.getElementById('vault-error');
			const key = 'mvp_vault_access';
			const expectedCodeRaw = form instanceof HTMLFormElement ? form.dataset.vaultCode || '' : '';
			const expectedCode = expectedCodeRaw.trim().toLowerCase();

			if (localStorage.getItem(key) === 'granted') {
				window.location.href = '/vault/library';
			}

			form?.addEventListener('submit', (event) => {
				event.preventDefault();
				const codeInput = document.getElementById('vault-code');
				const entered = codeInput instanceof HTMLInputElement ? codeInput.value.trim().toLowerCase() : '';
				if (!expectedCode) {
					if (errorEl) errorEl.textContent = 'Vault is not configured yet. Set PUBLIC_VAULT_CODE in .env and restart.';
					return;
				}
				if (entered !== expectedCode) {
					if (errorEl) errorEl.textContent = 'Access code is not valid. Try again.';
					return;
				}
				localStorage.setItem(key, 'granted');
				window.location.href = '/vault/library';
			});
		</script>
	</body>
</html>
