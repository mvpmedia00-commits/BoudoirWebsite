---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { hasVaultAccess } from '../../lib/access';

if (!hasVaultAccess(Astro.cookies)) {
	return Astro.redirect('/vault');
}

const entries = (await getCollection('vault')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Vault Library | MVP Media"
			description="Protected vault library for private members."
			noIndex={true}
		/>
		<style>
			.vault-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1rem;
			}
			.vault-card {
				text-decoration: none;
				background: linear-gradient(145deg, var(--surface), var(--surface-elevated));
				border: 1px solid var(--stroke);
				border-radius: var(--radius);
				overflow: hidden;
			}
			.vault-card img {
				border-radius: 0;
				width: 100%;
				aspect-ratio: 4/3;
				object-fit: cover;
			}
			.vault-content {
				padding: 0.85rem;
			}
			.vault-meta {
				display: flex;
				justify-content: space-between;
				gap: 0.5rem;
				font-size: 0.74rem;
				text-transform: uppercase;
				color: var(--text-muted);
				margin-bottom: 0.35rem;
			}
			.vault-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem;
				margin-top: 0.5rem;
			}
			.vault-tags span {
				font-size: 0.7rem;
				padding: 0.2rem 0.45rem;
				border-radius: 999px;
				border: 1px solid var(--stroke);
				color: var(--text-muted);
			}
			@media (max-width: 760px) {
				.vault-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div id="vault-shell" class="vault-shell">
				<section class="section-header">
					<p class="eyebrow">Members Vault</p>
					<h1>Private Library</h1>
					<p>Private collections for approved members only.</p>
				</section>
				<section class="vault-grid">
					{
						entries.map((entry) => (
							<a class="vault-card" href={`/vault/${entry.id}/`}>
								{entry.data.coverImage && (
									<Image width={900} height={560} src={entry.data.coverImage} alt={entry.data.title} />
								)}
								<div class="vault-content">
									<div class="vault-meta">
										<span>Private</span>
										<span><FormattedDate date={entry.data.pubDate} /></span>
									</div>
									<h2>{entry.data.title}</h2>
									<p>{entry.data.description}</p>
									<div class="vault-tags">
										{entry.data.tags.map((tag) => <span>#{tag}</span>)}
									</div>
								</div>
							</a>
						))
					}
				</section>
			</div>
		</main>
		<Footer />
	</body>
</html>
