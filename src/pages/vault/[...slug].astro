---
import { getEntry, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

const entry = Astro.params.slug ? await getEntry('vault', Astro.params.slug) : undefined;

if (!entry) {
	return Astro.redirect('/vault');
}

const { Content } = await render(entry);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${entry.data.title} | Vault`} description={entry.data.description} noIndex={true} />
		<style>
			.vault-entry {
				display: none;
				max-width: 900px;
				margin: 0 auto;
				padding: 1.25rem;
				background: linear-gradient(145deg, var(--surface), var(--surface-elevated));
				border: 1px solid var(--stroke);
				border-radius: var(--radius);
			}
			.vault-entry.is-ready {
				display: block;
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 0.6rem;
			}
			.meta span {
				border: 1px solid var(--stroke);
				border-radius: 999px;
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				padding: 0.28rem 0.55rem;
				color: var(--text-muted);
			}
			.note {
				margin-top: 1rem;
				padding: 0.8rem;
				border-radius: 10px;
				background: rgba(255, 255, 255, 0.03);
				border: 1px solid var(--stroke);
				font-size: 0.92rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article id="vault-entry" class="vault-entry">
				<p class="eyebrow">Members Vault</p>
				<h1>{entry.data.title}</h1>
				<p>{entry.data.description}</p>
				<div class="meta">
					<span><FormattedDate date={entry.data.pubDate} /></span>
					{entry.data.tags.map((tag) => <span>#{tag}</span>)}
				</div>
				<Content />
				{entry.data.privateNote && <p class="note"><strong>Private Note:</strong> {entry.data.privateNote}</p>}
				<p><a href="/vault/library">Back to vault library</a></p>
			</article>
		</main>
		<Footer />
		<script is:inline>
			const key = 'mvp_vault_access';
			if (localStorage.getItem(key) !== 'granted') {
				window.location.href = '/vault';
			} else {
				const entry = document.getElementById('vault-entry');
				entry?.classList.add('is-ready');
			}
		</script>
	</body>
</html>
