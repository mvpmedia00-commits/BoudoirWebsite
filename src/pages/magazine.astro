---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { MAGAZINE, buyableEditions, isMagazineLive } from '../data/magazine';
import { SITE_MEDIA } from '../data/siteMedia';
import { hasAdultAccess } from '../lib/access';

if (!isMagazineLive) {
	return Astro.redirect('/');
}

// The magazine contains artistic nudity, so it sits behind the same 18+ confirmation as the landing pages.
const isAllowed = hasAdultAccess(Astro.cookies);
const pageTitle = [MAGAZINE.title, MAGAZINE.issue].filter(Boolean).join(', ');
const description = MAGAZINE.tagline || `${MAGAZINE.title}, a fine art magazine by ${SITE_TITLE}.`;
const cover = MAGAZINE.cover || SITE_MEDIA.about;

const toPriceNumber = (price: string) => {
	const match = price.replace(/,/g, '').match(/\d+(\.\d+)?/);
	return match ? match[0] : undefined;
};

const productSchema = {
	'@context': 'https://schema.org',
	'@type': 'Product',
	name: pageTitle,
	description,
	image: cover,
	brand: { '@type': 'Brand', name: SITE_TITLE },
	offers: buyableEditions
		.filter((edition) => toPriceNumber(edition.price))
		.map((edition) => ({
			'@type': 'Offer',
			name: `${edition.format} edition`,
			price: toPriceNumber(edition.price),
			priceCurrency: 'USD',
			url: edition.url,
			availability: 'https://schema.org/InStock'
		}))
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${pageTitle} | ${SITE_TITLE}`}
			description={description}
			image={cover}
			noIndex={true}
			jsonLd={isAllowed ? productSchema : null}
		/>
	</head>
	<body>
		<Header />
		<main class="magazine">
			{
				isAllowed ? (
					<>
						<section class="product">
							<div class="product-cover">
								<img data-portfolio src={cover} alt={`Cover of ${pageTitle}`} loading="eager" fetchpriority="high" decoding="async" />
							</div>
							<div class="product-info">
								<p class="eyebrow">The Magazine</p>
								<h1>{MAGAZINE.title}</h1>
								{MAGAZINE.issue && <p class="issue">{MAGAZINE.issue}</p>}
								{MAGAZINE.tagline && <p class="tagline">{MAGAZINE.tagline}</p>}
								{MAGAZINE.description.map((paragraph) => <p>{paragraph}</p>)}

								<div class="editions">
									{buyableEditions.map((edition) => (
										<div class="edition">
											<div class="edition-head">
												<h2>{edition.format}</h2>
												{edition.price && <span class="price">{edition.price}</span>}
											</div>
											{edition.note && <p class="edition-note">{edition.note}</p>}
											<a class="btn btn-solid" href={edition.url} target="_blank" rel="noopener noreferrer">
												Buy {edition.format} Edition
												<span class="sr-only"> (opens in a new tab)</span>
											</a>
										</div>
									))}
								</div>
								<p class="seller-note">
									{MAGAZINE.seller
										? `Sold and delivered by ${MAGAZINE.seller}. You will complete your purchase on their site.`
										: 'You will complete your purchase on our store.'}
								</p>
							</div>
						</section>

						{MAGAZINE.highlights.length > 0 && (
							<section class="highlights">
								<p class="eyebrow">Inside the Issue</p>
								<ul>
									{MAGAZINE.highlights.map((item) => <li>{item}</li>)}
								</ul>
							</section>
						)}

						{MAGAZINE.previews.length > 0 && (
							<section class="previews">
								<p class="eyebrow">A Look Inside</p>
								<div class="preview-grid">
									{MAGAZINE.previews.map((src, index) => (
										<div class="preview">
											<img data-portfolio src={src} alt={`${MAGAZINE.title} inside page ${index + 1}`} loading="lazy" decoding="async" />
										</div>
									))}
								</div>
							</section>
						)}

						<section class="magazine-cta">
							<h2>Book your own session</h2>
							<p>Private sessions are available across the United States.</p>
							<a class="btn btn-ghost" href="/booking">Book a Consultation</a>
						</section>
					</>
				) : (
					<section class="gate">
						<p class="eyebrow">18+ Only</p>
						<h1>{MAGAZINE.title}</h1>
						<p>
							This magazine contains artistic nudity and is intended for adults. Please confirm you are 18 or older to
							continue.
						</p>
						<a class="btn btn-solid" href="/api/adult-access?returnTo=/magazine">I am 18 or older</a>
						<a class="btn btn-ghost" href="/">Return home</a>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.magazine {
		max-width: 1200px;
		margin: 0 auto;
		padding-top: clamp(2.5rem, 6vw, 4.5rem);
	}
	.product {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: start;
	}
	.product-cover {
		position: sticky;
		top: 6rem;
		aspect-ratio: 3 / 4;
		border-radius: 6px;
		overflow: hidden;
		border: 1px solid var(--stroke);
		background: var(--surface);
		box-shadow: 0 30px 60px rgba(0, 0, 0, 0.55);
	}
	.product-cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.product-info h1 {
		font-size: clamp(2.4rem, 5vw, 4rem);
		margin-bottom: 0.3rem;
	}
	.issue {
		color: var(--brand-strong);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		font-size: 0.8rem;
	}
	.tagline {
		font-size: 1.15rem;
		color: #d8d2cb;
	}
	.editions {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
		gap: 1rem;
		margin-top: 2rem;
	}
	.edition {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1.4rem;
		border: 1px solid var(--stroke);
		border-radius: var(--radius);
		background: linear-gradient(145deg, var(--surface), var(--surface-elevated));
	}
	.edition-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}
	.edition h2 {
		margin: 0;
		font-size: 1.5rem;
	}
	.price {
		color: var(--text-primary);
		font-size: 1.2rem;
		font-weight: 700;
	}
	.edition-note {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.6;
	}
	.edition .btn {
		margin-top: auto;
		text-align: center;
	}
	.seller-note {
		margin-top: 1rem;
		font-size: 0.85rem;
	}
	.highlights,
	.previews,
	.magazine-cta {
		margin-top: clamp(3rem, 7vw, 5rem);
		padding-top: clamp(2rem, 5vw, 3rem);
		border-top: 1px solid var(--stroke);
	}
	.highlights ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
		gap: 1rem 2rem;
	}
	.highlights li {
		color: var(--text-muted);
		padding-left: 1.2rem;
		position: relative;
	}
	.highlights li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.7em;
		width: 0.5rem;
		height: 1px;
		background: var(--brand-strong);
	}
	.preview-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
		gap: 1rem;
	}
	.preview {
		aspect-ratio: 3 / 4;
		border-radius: 6px;
		overflow: hidden;
		border: 1px solid var(--stroke);
		background: var(--surface);
	}
	.preview img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.magazine-cta {
		text-align: center;
	}
	.magazine-cta p {
		margin-left: auto;
		margin-right: auto;
	}
	.magazine-cta .btn {
		display: inline-block;
	}
	.gate .btn {
		width: fit-content;
	}
	@media (max-width: 860px) {
		.product {
			grid-template-columns: 1fr;
		}
		.product-cover {
			position: static;
			max-width: 420px;
		}
	}
</style>
