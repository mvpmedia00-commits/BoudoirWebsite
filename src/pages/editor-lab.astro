---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Embeddable Editor Lab | ${SITE_TITLE}`}
			description="A curated lab of open source web photo/video editor libraries you can build directly into your website."
		/>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css" />
	</head>
	<body>
		<Header />
		<main class="lab-page">
			<section class="lab-hero">
				<p class="eyebrow">Editor Lab</p>
				<h1>Built-In Open Source Editor Lab</h1>
				<p>
					Three embedded tools are loaded in-page: <strong>Cropper.js</strong>, <strong>Fabric.js</strong>, and
					<strong>Konva</strong>.
				</p>
			</section>

			<section class="lab-tabs">
				<button type="button" class="tab-btn active" data-lab-target="cropper">Cropper.js</button>
				<button type="button" class="tab-btn" data-lab-target="fabric">Fabric.js</button>
				<button type="button" class="tab-btn" data-lab-target="konva">Konva</button>
			</section>

			<section class="lab-section editor-panel is-active" data-lab-panel="cropper">
				<div class="lab-head">
					<h2>Cropper.js Lab</h2>
					<p>Upload image, crop area, export cropped result.</p>
				</div>
				<div class="studio-grid">
					<div class="studio-controls">
						<label class="file-control">
							<span>Upload Image</span>
							<input type="file" accept="image/*" data-cropper-upload />
						</label>
						<div class="studio-actions">
							<button type="button" class="studio-btn" data-cropper-crop disabled>Crop</button>
							<button type="button" class="studio-btn studio-btn-solid" data-cropper-download disabled>Download</button>
						</div>
						<p class="editor-note">Drag the crop box in the preview, then click Crop.</p>
					</div>
					<div class="studio-canvas-wrap">
						<div class="cropper-preview-wrap" data-cropper-preview-wrap>
							<img data-cropper-image alt="Cropper preview" />
						</div>
						<canvas width="1200" height="800" data-cropper-canvas hidden></canvas>
						<p class="canvas-hint" data-cropper-hint>Upload an image to start cropping.</p>
					</div>
				</div>
			</section>

			<section class="lab-section editor-panel" data-lab-panel="fabric">
				<div class="lab-head">
					<h2>Fabric.js Lab</h2>
					<p>Upload background, add text, draw, and export canvas.</p>
				</div>
				<div class="studio-grid">
					<div class="studio-controls">
						<label class="file-control">
							<span>Upload Background</span>
							<input type="file" accept="image/*" data-fabric-upload />
						</label>
						<div class="studio-actions">
							<button type="button" class="studio-btn" data-fabric-add-text>Add Text</button>
							<button type="button" class="studio-btn" data-fabric-draw>Draw: Off</button>
						</div>
						<div class="studio-actions">
							<button type="button" class="studio-btn" data-fabric-clear>Clear</button>
							<button type="button" class="studio-btn studio-btn-solid" data-fabric-download>Download</button>
						</div>
					</div>
					<div class="studio-canvas-wrap">
						<canvas width="1200" height="800" data-fabric-canvas></canvas>
						<p class="canvas-hint" data-fabric-hint>Load an image or start drawing.</p>
					</div>
				</div>
			</section>

			<section class="lab-section editor-panel" data-lab-panel="konva">
				<div class="lab-head">
					<h2>Konva Lab</h2>
					<p>Upload image to stage, add draggable text, export result.</p>
				</div>
				<div class="studio-grid">
					<div class="studio-controls">
						<label class="file-control">
							<span>Upload Image</span>
							<input type="file" accept="image/*" data-konva-upload />
						</label>
						<div class="studio-actions">
							<button type="button" class="studio-btn" data-konva-add-text>Add Text</button>
							<button type="button" class="studio-btn studio-btn-solid" data-konva-download>Download</button>
						</div>
						<p class="editor-note">Drag text on the canvas after adding it.</p>
					</div>
					<div class="studio-canvas-wrap">
						<div class="konva-stage" data-konva-stage></div>
						<p class="canvas-hint" data-konva-hint>Upload an image to populate the stage.</p>
					</div>
				</div>
			</section>

			<section class="lab-section studio-section" hidden>
				<div class="lab-head">
					<h2>Mini Photo Studio (Built-In)</h2>
					<p>First integrated editor demo: upload an image, tweak settings live, then download.</p>
				</div>
				<div class="studio-grid">
					<div class="studio-controls">
						<label class="file-control">
							<span>Upload Image</span>
							<input type="file" accept="image/*" data-photo-upload />
						</label>
						<div class="control-row">
							<label>Brightness <strong data-value-for="brightness">100%</strong></label>
							<input type="range" min="0" max="200" value="100" data-control="brightness" />
						</div>
						<div class="control-row">
							<label>Contrast <strong data-value-for="contrast">100%</strong></label>
							<input type="range" min="0" max="200" value="100" data-control="contrast" />
						</div>
						<div class="control-row">
							<label>Saturation <strong data-value-for="saturate">100%</strong></label>
							<input type="range" min="0" max="200" value="100" data-control="saturate" />
						</div>
						<div class="control-row">
							<label>Hue <strong data-value-for="hue">0°</strong></label>
							<input type="range" min="-180" max="180" value="0" data-control="hue" />
						</div>
						<div class="control-row">
							<label>Rotate <strong data-value-for="rotate">0°</strong></label>
							<input type="range" min="-180" max="180" value="0" data-control="rotate" />
						</div>
						<div class="control-row">
							<label>Zoom <strong data-value-for="zoom">100%</strong></label>
							<input type="range" min="50" max="220" value="100" data-control="zoom" />
						</div>
						<div class="studio-actions">
							<button type="button" class="studio-btn" data-reset-editor>Reset</button>
							<button type="button" class="studio-btn studio-btn-solid" data-download-editor disabled>Download</button>
						</div>
					</div>
					<div class="studio-canvas-wrap">
						<canvas width="1200" height="800" data-photo-canvas></canvas>
						<p class="canvas-hint" data-canvas-hint>Upload an image to start editing.</p>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script is:inline>
	const loadScript = (src) =>
		new Promise((resolve, reject) => {
			const existing = document.querySelector(`script[data-src="${src}"]`);
			if (existing) {
				resolve(true);
				return;
			}
			const script = document.createElement('script');
			script.src = src;
			script.async = true;
			script.dataset.src = src;
			script.onload = () => resolve(true);
			script.onerror = reject;
			document.head.appendChild(script);
		});

	const tabButtons = Array.from(document.querySelectorAll('[data-lab-target]'));
	const panels = Array.from(document.querySelectorAll('[data-lab-panel]'));
	tabButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const target = btn.dataset.labTarget;
			tabButtons.forEach((b) => b.classList.toggle('active', b === btn));
			panels.forEach((panel) => panel.classList.toggle('is-active', panel.dataset.labPanel === target));
		});
	});

	// Cropper.js editor
	let cropper = null;
	const cropperUpload = document.querySelector('[data-cropper-upload]');
	const cropperImage = document.querySelector('[data-cropper-image]');
	const cropperCanvas = document.querySelector('[data-cropper-canvas]');
	const cropperHint = document.querySelector('[data-cropper-hint]');
	const cropBtn = document.querySelector('[data-cropper-crop]');
	const cropDownloadBtn = document.querySelector('[data-cropper-download]');
	const cropperWrap = document.querySelector('[data-cropper-preview-wrap]');

	const initCropper = async () => {
		await loadScript('https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js');
	};

	cropperUpload?.addEventListener('change', async (event) => {
		await initCropper();
		const file = event.target?.files?.[0];
		if (!file || !cropperImage) return;
		const url = URL.createObjectURL(file);
		cropperImage.src = url;
		cropperImage.onload = () => {
			cropper?.destroy?.();
			cropper = new window.Cropper(cropperImage, { viewMode: 1, dragMode: 'move' });
			if (cropperHint) cropperHint.textContent = 'Adjust crop area, then press Crop.';
			if (cropBtn instanceof HTMLButtonElement) cropBtn.disabled = false;
		};
	});

	cropBtn?.addEventListener('click', () => {
		if (!cropper || !(cropperCanvas instanceof HTMLCanvasElement)) return;
		const out = cropper.getCroppedCanvas({ maxWidth: 2200, maxHeight: 2200 });
		const ctx = cropperCanvas.getContext('2d');
		if (!ctx) return;
		cropperCanvas.hidden = false;
		cropperCanvas.width = out.width;
		cropperCanvas.height = out.height;
		ctx.clearRect(0, 0, out.width, out.height);
		ctx.drawImage(out, 0, 0);
		if (cropperWrap instanceof HTMLElement) cropperWrap.style.display = 'none';
		if (cropperHint) cropperHint.textContent = 'Cropped output preview';
		if (cropDownloadBtn instanceof HTMLButtonElement) cropDownloadBtn.disabled = false;
	});

	cropDownloadBtn?.addEventListener('click', () => {
		if (!(cropperCanvas instanceof HTMLCanvasElement)) return;
		const link = document.createElement('a');
		link.download = 'cropper-export.png';
		link.href = cropperCanvas.toDataURL('image/png');
		link.click();
	});

	// Fabric.js editor
	let fabricCanvas = null;
	const fabricUpload = document.querySelector('[data-fabric-upload]');
	const fabricCanvasEl = document.querySelector('[data-fabric-canvas]');
	const fabricHint = document.querySelector('[data-fabric-hint]');
	const fabricAddTextBtn = document.querySelector('[data-fabric-add-text]');
	const fabricDrawBtn = document.querySelector('[data-fabric-draw]');
	const fabricClearBtn = document.querySelector('[data-fabric-clear]');
	const fabricDownloadBtn = document.querySelector('[data-fabric-download]');

	const initFabric = async () => {
		if (!fabricCanvas && fabricCanvasEl instanceof HTMLCanvasElement) {
			await loadScript('https://cdn.jsdelivr.net/npm/fabric@5.3.0/dist/fabric.min.js');
			fabricCanvas = new window.fabric.Canvas(fabricCanvasEl, { backgroundColor: '#101010' });
		}
	};

	fabricUpload?.addEventListener('change', async (event) => {
		await initFabric();
		const file = event.target?.files?.[0];
		if (!file || !fabricCanvas) return;
		const reader = new FileReader();
		reader.onload = () => {
			window.fabric.Image.fromURL(reader.result, (img) => {
				if (!img) return;
				const cW = fabricCanvas.getWidth();
				const cH = fabricCanvas.getHeight();
				const scale = Math.min(cW / img.width, cH / img.height);
				img.set({
					left: (cW - img.width * scale) / 2,
					top: (cH - img.height * scale) / 2,
					scaleX: scale,
					scaleY: scale,
					selectable: false,
					evented: false
				});
				fabricCanvas.clear();
				fabricCanvas.setBackgroundColor('#101010', fabricCanvas.renderAll.bind(fabricCanvas));
				fabricCanvas.add(img);
				img.sendToBack();
				fabricCanvas.renderAll();
				if (fabricHint) fabricHint.textContent = 'Background loaded. Add text or draw.';
			});
		};
		reader.readAsDataURL(file);
	});

	fabricAddTextBtn?.addEventListener('click', async () => {
		await initFabric();
		if (!fabricCanvas) return;
		const text = new window.fabric.IText('Edit me', {
			left: 120,
			top: 120,
			fill: '#ffffff',
			fontSize: 42,
			fontWeight: '700'
		});
		fabricCanvas.add(text);
		fabricCanvas.setActiveObject(text);
		fabricCanvas.renderAll();
	});

	fabricDrawBtn?.addEventListener('click', async () => {
		await initFabric();
		if (!fabricCanvas) return;
		fabricCanvas.isDrawingMode = !fabricCanvas.isDrawingMode;
		if (fabricCanvas.freeDrawingBrush) {
			fabricCanvas.freeDrawingBrush.color = '#d4c2a1';
			fabricCanvas.freeDrawingBrush.width = 6;
		}
		if (fabricDrawBtn instanceof HTMLButtonElement) {
			fabricDrawBtn.textContent = `Draw: ${fabricCanvas.isDrawingMode ? 'On' : 'Off'}`;
		}
	});

	fabricClearBtn?.addEventListener('click', async () => {
		await initFabric();
		if (!fabricCanvas) return;
		fabricCanvas.clear();
		fabricCanvas.setBackgroundColor('#101010', fabricCanvas.renderAll.bind(fabricCanvas));
		if (fabricHint) fabricHint.textContent = 'Canvas cleared.';
	});

	fabricDownloadBtn?.addEventListener('click', async () => {
		await initFabric();
		if (!fabricCanvas) return;
		const link = document.createElement('a');
		link.download = 'fabric-export.png';
		link.href = fabricCanvas.toDataURL({ format: 'png', multiplier: 1 });
		link.click();
	});

	// Konva editor
	let konvaStage = null;
	let konvaLayer = null;
	const konvaUpload = document.querySelector('[data-konva-upload]');
	const konvaStageEl = document.querySelector('[data-konva-stage]');
	const konvaHint = document.querySelector('[data-konva-hint]');
	const konvaAddTextBtn = document.querySelector('[data-konva-add-text]');
	const konvaDownloadBtn = document.querySelector('[data-konva-download]');

	const initKonva = async () => {
		if (!konvaStage && konvaStageEl) {
			await loadScript('https://cdn.jsdelivr.net/npm/konva@9.3.16/konva.min.js');
			const width = Math.max(320, konvaStageEl.clientWidth);
			const height = 520;
			konvaStage = new window.Konva.Stage({ container: konvaStageEl, width, height });
			konvaLayer = new window.Konva.Layer();
			konvaStage.add(konvaLayer);
		}
	};

	konvaUpload?.addEventListener('change', async (event) => {
		await initKonva();
		const file = event.target?.files?.[0];
		if (!file || !konvaStage || !konvaLayer) return;
		const reader = new FileReader();
		reader.onload = () => {
			const img = new Image();
			img.onload = () => {
				konvaLayer.destroyChildren();
				const fit = Math.min(konvaStage.width() / img.width, konvaStage.height() / img.height);
				const konvaImg = new window.Konva.Image({
					image: img,
					x: (konvaStage.width() - img.width * fit) / 2,
					y: (konvaStage.height() - img.height * fit) / 2,
					width: img.width * fit,
					height: img.height * fit
				});
				konvaLayer.add(konvaImg);
				konvaLayer.draw();
				if (konvaHint) konvaHint.textContent = 'Image loaded. Add text and drag.';
			};
			img.src = reader.result;
		};
		reader.readAsDataURL(file);
	});

	konvaAddTextBtn?.addEventListener('click', async () => {
		await initKonva();
		if (!konvaLayer) return;
		const text = new window.Konva.Text({
			text: 'Edit text',
			x: 80,
			y: 80,
			fontSize: 42,
			fontStyle: 'bold',
			fill: '#ffffff',
			draggable: true
		});
		const tr = new window.Konva.Transformer({ nodes: [text], rotateEnabled: false });
		konvaLayer.add(text);
		konvaLayer.add(tr);
		konvaLayer.draw();
	});

	konvaDownloadBtn?.addEventListener('click', async () => {
		await initKonva();
		if (!konvaStage) return;
		const link = document.createElement('a');
		link.download = 'konva-export.png';
		link.href = konvaStage.toDataURL({ pixelRatio: 2 });
		link.click();
	});
</script>

<style>
	.lab-page {
		padding-top: 1.2rem;
	}
	.lab-hero {
		margin-bottom: 1.4rem;
		max-width: 900px;
	}
	.lab-hero h1 {
		margin-bottom: 0.55rem;
	}
	.lab-section {
		margin-bottom: 1.2rem;
	}
	.studio-section {
		margin-bottom: 1.6rem;
	}
	.lab-tabs {
		display: flex;
		gap: 0.55rem;
		flex-wrap: wrap;
		margin-bottom: 0.9rem;
	}
	.tab-btn {
		border: 1px solid var(--stroke);
		background: transparent;
		color: var(--text-muted);
		padding: 0.5rem 0.78rem;
		border-radius: 999px;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		cursor: pointer;
	}
	.tab-btn.active {
		background: rgba(212, 194, 161, 0.18);
		color: var(--text-primary);
		border-color: rgba(212, 194, 161, 0.45);
	}
	.editor-panel {
		display: none;
	}
	.editor-panel.is-active {
		display: block;
	}
	.lab-head {
		margin-bottom: 0.65rem;
	}
	.lab-head p {
		margin: 0;
	}
	.studio-grid {
		display: grid;
		grid-template-columns: 320px 1fr;
		gap: 0.85rem;
	}
	.studio-controls,
	.studio-canvas-wrap {
		background: linear-gradient(145deg, var(--surface), var(--surface-elevated));
		border: 1px solid var(--stroke);
		border-radius: var(--radius);
		padding: 0.9rem;
	}
	.file-control {
		display: grid;
		gap: 0.38rem;
		margin-bottom: 0.7rem;
	}
	.file-control span {
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--brand-deep);
		font-weight: 700;
	}
	.control-row {
		display: grid;
		gap: 0.26rem;
		margin-bottom: 0.55rem;
	}
	.control-row label {
		font-size: 0.8rem;
		display: flex;
		justify-content: space-between;
		gap: 0.7rem;
		color: var(--text-muted);
	}
	.control-row input[type='range'] {
		width: 100%;
	}
	.studio-actions {
		display: flex;
		gap: 0.55rem;
		margin-top: 0.25rem;
	}
	.studio-btn {
		border: 1px solid var(--stroke);
		background: transparent;
		color: var(--text-primary);
		padding: 0.5rem 0.75rem;
		border-radius: 999px;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		cursor: pointer;
	}
	.studio-btn-solid {
		background: var(--brand-strong);
		color: #090909;
		border-color: var(--brand-strong);
	}
	.studio-btn:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}
	.studio-canvas-wrap {
		position: relative;
		min-height: 520px;
		display: grid;
		place-items: center;
		overflow: hidden;
	}
	.studio-canvas-wrap canvas {
		width: 100%;
		height: auto;
		max-height: 620px;
		background: #0a0a0a;
		border-radius: 12px;
	}
	.cropper-preview-wrap {
		width: 100%;
		min-height: 460px;
		display: grid;
		place-items: center;
		overflow: hidden;
		background: #0a0a0a;
		border-radius: 12px;
	}
	.cropper-preview-wrap img {
		max-width: 100%;
		display: block;
	}
	.konva-stage {
		width: 100%;
		min-height: 520px;
		background: #0b0b0b;
		border-radius: 12px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.08);
	}
	.canvas-hint {
		position: absolute;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%);
		margin: 0;
		padding: 0.5rem 0.7rem;
		background: rgba(0, 0, 0, 0.6);
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 999px;
		font-size: 0.74rem;
		color: #cfcfcf;
	}
	.editor-note {
		margin: 0.35rem 0 0;
		font-size: 0.82rem;
		color: var(--text-muted);
	}
	@media (max-width: 760px) {
		.studio-grid {
			grid-template-columns: 1fr;
		}
		.studio-canvas-wrap {
			min-height: 360px;
		}
		.cropper-preview-wrap {
			min-height: 300px;
		}
		.konva-stage {
			min-height: 360px;
		}
	}
</style>
