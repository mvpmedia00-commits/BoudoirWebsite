---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import NicheGallery from '../../components/ui/NicheGallery.astro';
import { getNicheBySlug } from '../../lib/niches';
import { SITE_MEDIA } from '../../data/siteMedia';
import { hasAdultAccess as readAdultAccess } from '../../lib/access';

const slug = Astro.params.slug ?? '';
const niche = getNicheBySlug(slug);

if (!niche) {
	return Astro.redirect('/');
}

const hasAdultAccess = readAdultAccess(Astro.cookies);
const requiresGate = niche.isMature === true;
const isAllowed = !requiresGate || hasAdultAccess;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${niche.title} | MVP Media`}
			description={niche.description}
			image={SITE_MEDIA.two}
			noIndex={requiresGate}
		/>
	</head>
	<body>
		<Header />
		<main>
			{
				isAllowed ? (
					<>
						<section class="niche-hero">
							<div>
								<h1>{niche.title}</h1>
								<p>{niche.hero}</p>
							</div>
							<div class="niche-hero-media">
								<img src={SITE_MEDIA.two} alt={`${niche.name} portrait by MVP Media`} loading="eager" decoding="async" />
							</div>
						</section>

						<section class="niche-section">
							<h2>Featured Work</h2>
							<NicheGallery niche={niche.slug} />
						</section>

						<section class="niche-section two-col">
							<div>
								<h2>What to expect</h2>
								<ul>
									<li><strong>Planning:</strong> Clear session planning from first message to final gallery.</li>
									<li><strong>Comfort:</strong> Direction that keeps your session relaxed, private, and unhurried.</li>
									<li><strong>Results:</strong> Cinematic {niche.name.toLowerCase()} images, carefully retouched and delivered privately.</li>
								</ul>
								<p class="trust">Sessions available across the United States.</p>
							</div>
							<div>
								<h2>Request a consultation</h2>
								<LeadForm niche={niche.slug} source={`${niche.slug}-page`} />
							</div>
						</section>
					</>
				) : (
					<section class="gate">
						<p class="eyebrow">Private Access</p>
						<h1>Mature Artistic Portfolio</h1>
						<p>
							This page contains mature, non-explicit portrait work intended for adults. Please confirm you are 18 or older
							to continue.
						</p>
						<a class="btn btn-solid" href={`/api/adult-access?returnTo=/land/${niche.slug}`}>I am 18 or older</a>
						<a class="btn btn-ghost" href="/">Return home</a>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		padding-top: 1.4rem;
	}
	.niche-hero {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: center;
		margin-bottom: 2.5rem;
	}
	.niche-hero-media {
		border-radius: var(--radius);
		overflow: hidden;
		border: 1px solid var(--stroke);
		aspect-ratio: 4 / 5;
		width: min(100%, 460px);
		justify-self: center;
	}
	.niche-hero-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.niche-section {
		margin-bottom: 1.4rem;
	}
	.two-col {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}
	ul {
		margin: 0 0 1rem;
		padding-left: 1.2rem;
		display: grid;
		gap: 0.55rem;
	}
	li {
		color: var(--text-muted);
	}
	.trust {
		margin: 0;
		color: var(--text-primary);
		font-weight: 700;
	}
	.gate .btn {
		width: fit-content;
	}
	@media (max-width: 900px) {
		.niche-hero,
		.two-col {
			grid-template-columns: 1fr;
		}
	}
</style>
