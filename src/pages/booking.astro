---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import LeadForm from '../components/ui/LeadForm.astro';
import { SITE_TITLE } from '../consts';

const sessions = [
	{ title: 'Boudoir', copy: 'Guided sessions in the studio or a private location of your choice.' },
	{ title: 'Artistic Nude', copy: 'Fine art portraiture shaped by form, light, and composition.' },
	{ title: 'Body Paint', copy: 'Collaborative body-art concepts, from first sketch to final frame.' },
	{ title: 'After Dark Editorial', copy: 'Low-light cinematic sets with controlled mood and styling.' },
	{ title: 'Editorial Portrait', copy: 'Portraits for creators and brands, with no nudity.' },
	{ title: 'Film', copy: 'Short cinematic films, on their own or alongside a photo session.' }
];

const steps = [
	'We read your inquiry and reply privately.',
	'You receive session options, pricing, and availability.',
	'We agree on the plan and confirm your date.'
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Book a Consultation | ${SITE_TITLE}`}
			description="Request a private consultation for a boudoir, artistic nude, body paint, editorial, or film session with MVP Media."
		/>
	</head>
	<body>
		<Header />
		<main class="booking">
			<div class="booking-grid">
				<div class="booking-info">
					<p class="eyebrow">Book a Consultation</p>
					<h1>Let's plan your session.</h1>
					<p class="lead">
						Tell us about your idea, your comfort level, and your preferred timeline. Every inquiry is read personally and
						answered privately.
					</p>

					<h2>Sessions</h2>
					<ul class="sessions">
						{sessions.map((session) => (
							<li>
								<h3>{session.title}</h3>
								<p>{session.copy}</p>
							</li>
						))}
					</ul>

					<h2>What happens next</h2>
					<ol class="steps">
						{steps.map((step) => <li>{step}</li>)}
					</ol>
				</div>

				<div class="booking-form">
					<LeadForm niche="boudoir" source="booking-page" chooseSession />
					<p class="direct">Prefer email? Write to <a href="mailto:hello@mvpmedia.studio">hello@mvpmedia.studio</a>.</p>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.booking {
		max-width: 1200px;
		margin: 0 auto;
		padding-top: clamp(2.5rem, 6vw, 4.5rem);
	}
	.booking-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: start;
	}
	.booking h1 {
		font-size: clamp(2.4rem, 5vw, 3.8rem);
	}
	.lead {
		font-size: 1.08rem;
		color: #d8d2cb;
	}
	.booking h2 {
		margin-top: 2.25rem;
		font-size: 1.6rem;
	}
	.sessions {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem 1.5rem;
	}
	.sessions h3 {
		font-size: 1.2rem;
		margin-bottom: 0.25rem;
	}
	.sessions p {
		margin: 0;
		font-size: 0.93rem;
		line-height: 1.6;
	}
	.steps {
		margin: 0;
		padding-left: 1.2rem;
		color: var(--text-muted);
		display: grid;
		gap: 0.5rem;
	}
	.steps li::marker {
		color: var(--brand-strong);
	}
	.booking-form {
		position: sticky;
		top: 6rem;
	}
	.direct {
		margin-top: 1rem;
		font-size: 0.9rem;
		text-align: center;
		max-width: none;
	}
	@media (max-width: 900px) {
		.booking-grid {
			grid-template-columns: 1fr;
		}
		.booking-form {
			position: static;
		}
	}
	@media (max-width: 520px) {
		.sessions {
			grid-template-columns: 1fr;
		}
	}
</style>
