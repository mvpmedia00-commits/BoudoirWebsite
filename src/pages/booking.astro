---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import LeadForm from '../components/ui/LeadForm.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Booking | ${SITE_TITLE}`} description="Start your after dark boudoir project with a discreet intake and fast response." />
	</head>
	<body>
		<Header />
		<main>
			<section class="booking-intro">
				<p class="eyebrow">Booking</p>
				<h1>Start Your Boudoir Session</h1>
				<p>
					Share your vision, comfort level, and preferred timeline. We qualify first, then schedule privately.
				</p>
			</section>

			<section class="offers">
				<article>
					<h2>Private Boudoir</h2>
					<p>Discreet boudoir sessions in studio or private location with guided direction.</p>
				</article>
				<article>
					<h2>Artistic Nude</h2>
					<p>Fine-art nude portrait direction with tasteful framing and privacy-first pacing.</p>
				</article>
				<article>
					<h2>Afterdark Editorial</h2>
					<p>Low-light cinematic sets with controlled mood, styling, and confidential delivery.</p>
				</article>
			</section>

			<section class="next-steps">
				<h2>What Happens Next</h2>
				<p>1. We review your inquiry and goals.</p>
				<p>2. You receive options, pricing range, and availability.</p>
				<p>3. We confirm scope and lock in your date.</p>
			</section>

			<section>
				<LeadForm niche="boudoir" source="booking-page" />
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		display: grid;
		gap: 1.1rem;
	}
	.booking-intro,
	.next-steps,
	.offers article {
		background: linear-gradient(145deg, var(--surface), var(--surface-elevated));
		border: 1px solid var(--stroke);
		border-radius: var(--radius);
		padding: 1.1rem;
	}
	.offers {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.8rem;
	}
	.next-steps p {
		margin-bottom: 0.4rem;
	}
	@media (max-width: 900px) {
		.offers {
			grid-template-columns: 1fr;
		}
	}
</style>
