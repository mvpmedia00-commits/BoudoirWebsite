---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import GalleryCanvas from '../../components/gallery/GalleryCanvas.astro';
import AgeGate from '../../components/AgeGate.astro';
import ExplicitLock from '../../components/ui/ExplicitLock.astro';
import { SITE_TITLE } from '../../consts';
import { GALLERY_CATEGORIES, getGalleryItemsByCategory } from '../../data/galleryMedia';

const category = GALLERY_CATEGORIES.find((entry) => entry.slug === Astro.params.category);

if (!category) {
	return Astro.redirect('/gallery');
}

const items = getGalleryItemsByCategory(category.slug);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${category.label} | ${SITE_TITLE}`} description={category.description} />
	</head>
	<body>
		<Header />
		<div id="gallery" data-explicit={category.sensitive ? '' : undefined}>
			<GalleryCanvas title={category.label} description={category.description} items={items} />
		</div>
		{category.sensitive && (
			<main class="locked-gallery">
				<p class="eyebrow"><a href="/gallery">Portfolio</a></p>
				<h1>{category.label}</h1>
				<p class="lead">{category.description}</p>
				<ExplicitLock label="Explicit gallery" action />
			</main>
		)}
		<Footer />
		<div id="ageGate">
			<AgeGate redirectTo="/gallery" />
		</div>
		<script>
			const verified = localStorage.getItem('ageVerified') === 'true';
			const ageGate = document.getElementById('ageGate');
			const gallery = document.getElementById('gallery');
			if (ageGate) ageGate.style.display = verified ? 'none' : 'block';
			if (gallery) gallery.style.display = verified ? 'block' : 'none';
		</script>
	</body>
</html>

<style>
	.locked-gallery {
		max-width: 820px;
		margin: 0 auto;
		padding: 1rem 1rem 3rem;
	}
	.locked-gallery h1 {
		font-size: clamp(2rem, 6vw, 4.2rem);
		margin: 0.2rem 0 0.5rem;
	}
	.locked-gallery .eyebrow a {
		color: inherit;
		text-decoration: none;
	}
	.locked-gallery :global(.explicit-lock) {
		min-height: 320px;
		margin-top: 1.5rem;
		border: 1px solid var(--stroke);
		border-radius: var(--radius);
	}
</style>
