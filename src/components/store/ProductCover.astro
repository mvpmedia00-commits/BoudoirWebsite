---
import { SITE_TITLE } from '../../consts';

interface Props {
	title: string;
	subtitle?: string;
	image?: string;
	/** 18+ item: blurred with an 18+ badge while the visitor has the 18+ blur switch on. */
	mature?: boolean;
	eager?: boolean;
}

const { title, subtitle, image, mature = false, eager = false } = Astro.props;
---

<div class="cover" data-veil={mature && image ? '' : undefined}>
	<div class="title-card" aria-hidden="true">
		<span class="brand">{SITE_TITLE}</span>
		<span class="name">{title}</span>
		{subtitle && <span class="sub">{subtitle}</span>}
	</div>
	{image && (
		<img
			src={image}
			alt={title}
			loading={eager ? 'eager' : 'lazy'}
			decoding="async"
			onerror="this.parentElement.removeAttribute('data-veil');this.remove()"
		/>
	)}
</div>

<style>
	.cover {
		position: relative;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		border-radius: 12px;
		border: 1px solid var(--stroke);
		background: var(--surface);
	}
	.cover img {
		position: relative;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		transition: transform 0.5s ease;
	}
	/* Styled stand-in until the item has a photo. */
	.title-card {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 1.4rem;
		background:
			radial-gradient(circle at 25% 15%, rgba(196, 106, 123, 0.35), transparent 55%),
			radial-gradient(circle at 80% 90%, rgba(240, 164, 93, 0.25), transparent 55%),
			linear-gradient(160deg, #1b1210, #070707);
		box-shadow: inset 0 0 0 1px rgba(212, 194, 161, 0.3);
	}
	.brand {
		color: var(--brand-strong);
		font-size: 0.7rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
	}
	.name {
		font-family: 'Cormorant Garamond', 'Times New Roman', serif;
		font-size: clamp(1.6rem, 3vw, 2.4rem);
		line-height: 1.05;
		color: #f5efe8;
	}
	.sub {
		color: var(--text-muted);
		font-size: 0.8rem;
		letter-spacing: 0.08em;
	}
</style>
