---
const heroImage = 'https://res.cloudinary.com/dg4xwrzu9/image/upload/v1772942536/5B1A2340_hocjor.jpg';
---

<section class="relative min-h-[90vh] flex flex-col items-center justify-center overflow-hidden bg-black">
  <video class="absolute inset-0 w-full h-full object-cover opacity-60 z-0" src="https://cdn.coverr.co/videos/coverr-a-city-at-night-1579/1080p.mp4" autoplay muted loop playsinline poster={heroImage}></video>
  <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/60 to-black/90 z-10"></div>
  <div class="relative z-20 flex flex-col items-center justify-center text-center px-4 py-24 w-full max-w-3xl mx-auto">
    <p class="uppercase tracking-widest text-pink-400 font-bold text-sm mb-4">MVP Media</p>
    <h1 class="text-white font-extrabold text-5xl md:text-7xl leading-tight mb-4 drop-shadow-lg">VERTICAL<br />FIRST</h1>
    <p class="text-neutral-200 text-xl md:text-2xl font-semibold mb-2">Videoagentur mit Allergie gegen Mittelmaß.</p>
    <p class="text-neutral-300 text-lg md:text-xl mb-8">Wir produzieren strategische Videos für Marken, die mehr wollen als Standard. Plattformgerecht umgesetzt. Auf Wirkung ausgelegt.</p>
    <a class="inline-block bg-pink-500 hover:bg-pink-400 text-white font-bold px-8 py-4 rounded-full text-lg shadow-lg transition mb-8" href="/booking">Jetzt starten</a>
    <div class="flex flex-wrap justify-center gap-8 mt-4">
      <div class="flex flex-col items-center">
        <span class="text-3xl md:text-4xl font-bold text-pink-400 animate-pulse">+5Mio.</span>
        <span class="text-neutral-400 text-sm">Monatliche Views</span>
      </div>
      <div class="flex flex-col items-center">
        <span class="text-3xl md:text-4xl font-bold text-pink-400 animate-pulse">+25K</span>
        <span class="text-neutral-400 text-sm">Produzierte Clips</span>
      </div>
      <div class="flex flex-col items-center">
        <span class="text-3xl md:text-4xl font-bold text-pink-400 animate-pulse">+100%</span>
        <span class="text-neutral-400 text-sm">Commitment</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* nano-banana.io inspired hero styles */
  section {
    position: relative;
    min-height: 90vh;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000;
  }
  video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.6;
    z-index: 0;
  }
  .z-10 {
    z-index: 10;
  }
  .z-20 {
    z-index: 20;
  }
  .drop-shadow-lg {
    filter: drop-shadow(0 4px 24px rgba(0,0,0,0.5));
  }
  .animate-pulse {
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }
  .eyebrow {
    color: #ff8da1;
    text-transform: uppercase;
    font-size: 0.73rem;
    letter-spacing: 0.09em;
    margin: 0 0 0.5rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 7vw, 4.7rem);
    line-height: 0.88;
    color: #ff8da1;
  }
  .subline {
    margin: 0.9rem 0 0.5rem;
    color: #fff;
    font-size: 1.2rem;
    max-width: 22ch;
  }
  .body {
    color: #b3b3b3;
    max-width: 42ch;
    margin-bottom: 1rem;
  }
  .cta {
    width: fit-content;
    text-decoration: none;
    color: #171717;
    background: #ff8da1;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    font-size: 0.78rem;
  }
  .hero-media {
    background: #0f0f0f;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 28px;
    padding: 0.7rem;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 0.6rem;
  }
  .hero-video {
    width: 100%;
    height: 100%;
    min-height: 360px;
    object-fit: cover;
    border-radius: 20px;
    display: block;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.4rem;
  }
  .stats div {
    background: #141414;
    border: 1px solid rgba(255,255,255,0.09);
    border-radius: 14px;
    text-align: center;
    padding: 0.55rem 0.4rem;
  }
  .stats span {
    display: block;
    font-weight: 800;
    color: #f6f6f6;
  }
  .stats small {
    color: #a2a2a2;
    font-size: 0.72rem;
  }
  @media (max-width: 860px) {
    .hero-wrap {
      grid-template-columns: 1fr;
    }
    .hero-video {
      min-height: 300px;
    }
  }
</style>
