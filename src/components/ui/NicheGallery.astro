---
import { SITE_MEDIA, photosForSlug } from '../../data/siteMedia';

interface Props {
	niche: string;
}

const { niche } = Astro.props;

// Real photos for this niche when uploaded; otherwise the placeholder set.
const nichePhotos = photosForSlug(niche);
const fallbackCards = nichePhotos.length
	? nichePhotos.map((image, index) => ({ title: `${niche.replace('-', ' ')} ${String(index + 1).padStart(2, '0')}`, image }))
	: [
	{ title: `${niche} session highlight`, image: SITE_MEDIA.one },
	{ title: `${niche} detail frame`, image: SITE_MEDIA.two },
	{ title: `${niche} hero composition`, image: SITE_MEDIA.three },
	{ title: `${niche} ambient portrait`, image: SITE_MEDIA.four },
	{ title: `${niche} closing shot`, image: SITE_MEDIA.five }
	];
---

<div class="niche-gallery" data-niche-gallery data-niche={niche}>
	{fallbackCards.map((card) => (
		<figure>
			<img src={card.image} alt={card.title} loading="lazy" />
			<figcaption>{card.title}</figcaption>
		</figure>
	))}
</div>

<script>
	type MediaItem = { title?: string; thumb_url?: string; media_url?: string };

	const galleries = document.querySelectorAll<HTMLElement>('[data-niche-gallery]');

	const renderGallery = (root: HTMLElement, items: MediaItem[]) => {
		if (!Array.isArray(items) || items.length === 0) return;
		root.innerHTML = '';
		items.forEach((item) => {
			const figure = document.createElement('figure');
			const img = document.createElement('img');
			img.src = item.thumb_url || item.media_url || '';
			img.alt = item.title || 'Gallery media';
			img.loading = 'lazy';
			const caption = document.createElement('figcaption');
			caption.textContent = item.title || 'Untitled';
			figure.append(img, caption);
			root.appendChild(figure);
		});
	};

	galleries.forEach(async (root) => {
		const niche = root.dataset.niche || '';
		try {
			const response = await fetch(`/api/media?niche=${encodeURIComponent(niche)}&limit=12`, {
				headers: { Accept: 'application/json' }
			});
			if (!response.ok) return;
			const data = await response.json();
			renderGallery(root, data.items || []);
		} catch {
			// Keep fallback content rendered server-side.
		}
	});
</script>

<style>
	.niche-gallery {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
		gap: 0.8rem;
	}
	figure {
		margin: 0;
		border: 1px solid var(--stroke);
		border-radius: 0.9rem;
		overflow: hidden;
		background: var(--surface);
	}
	img {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 0;
	}
	figcaption {
		font-size: 0.86rem;
		padding: 0.6rem 0.75rem;
		color: var(--text-muted);
		text-transform: capitalize;
	}
	@media (max-width: 900px) {
		.niche-gallery {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
