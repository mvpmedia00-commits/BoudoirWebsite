---
interface Props {
	niche: string;
	source?: string;
	/** Let the visitor choose the session type instead of using `niche`. */
	chooseSession?: boolean;
}

const { niche, source = '', chooseSession = false } = Astro.props;
const formId = `lead-${source || niche}`;

const SESSION_TYPES = [
	{ value: 'boudoir', label: 'Boudoir' },
	{ value: 'artistic-nude', label: 'Artistic Nude' },
	{ value: 'body-paint', label: 'Body Paint' },
	{ value: 'editorial-portrait', label: 'Editorial Portrait' },
	{ value: 'afterdark', label: 'After Dark Editorial' },
	{ value: 'film', label: 'Film' },
	{ value: 'general', label: 'Not sure yet' }
];
---

<form class="lead-form" data-lead-form data-niche={niche} data-source={source}>
	<div class="field-row">
		<div class="field">
			<label for={`${formId}-name`}>Name</label>
			<input id={`${formId}-name`} name="name" autocomplete="name" required />
		</div>
		<div class="field">
			<label for={`${formId}-email`}>Email</label>
			<input id={`${formId}-email`} name="email" type="email" autocomplete="email" required />
		</div>
	</div>
	<div class="field-row">
		{chooseSession && (
			<div class="field">
				<label for={`${formId}-niche`}>Session type</label>
				<select id={`${formId}-niche`} name="niche" required>
					{SESSION_TYPES.map((type) => <option value={type.value} selected={type.value === niche}>{type.label}</option>)}
				</select>
			</div>
		)}
		<div class="field">
			<label for={`${formId}-budget`}>Budget in USD <span class="optional">(optional)</span></label>
			<input id={`${formId}-budget`} name="budget" type="number" min="0" step="50" inputmode="numeric" />
		</div>
	</div>
	<div class="field">
		<label for={`${formId}-message`}>Your idea</label>
		<textarea
			id={`${formId}-message`}
			name="message"
			rows={5}
			placeholder="The mood you have in mind, preferred dates, and anything we should know about your comfort level."
		></textarea>
	</div>
	<button type="submit">Request a Consultation</button>
	<p class="form-note">Your details are kept confidential.</p>
	<p class="lead-feedback" data-feedback role="status" aria-live="polite"></p>
</form>

<script>
	document.querySelectorAll<HTMLFormElement>('form[data-lead-form]').forEach((form) => {
		const feedback = form.querySelector<HTMLElement>('[data-feedback]');
		const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
		if (!feedback || !button) return;
		const buttonLabel = button.textContent || 'Request a Consultation';
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const data = new FormData(form);
			const payload = {
				name: data.get('name'),
				email: data.get('email'),
				budget: data.get('budget') ? Number(data.get('budget')) : null,
				message: data.get('message'),
				niche: String(data.get('niche') || form.dataset.niche || ''),
				source: form.dataset.source || (() => {
					const path = window.location.pathname;
					if (path === '/') return 'homepage';
					if (path === '/booking') return 'booking-page';
					if (path.startsWith('/land/')) return `${path.split('/')[2] || 'landing'}-page`;
					return 'direct-page';
				})(),
				utm_source: new URLSearchParams(window.location.search).get('utm_source') || '',
				utm_medium: new URLSearchParams(window.location.search).get('utm_medium') || '',
				utm_campaign: new URLSearchParams(window.location.search).get('utm_campaign') || '',
				referrer: document.referrer || ''
			};

			button.disabled = true;
			button.textContent = 'Sending...';
			feedback.textContent = '';

			try {
				const response = await fetch('/api/leads', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(payload)
				});

				if (!response.ok) {
					throw new Error('Submission failed');
				}

				const tracker = window.mvpTrack;
				if (typeof tracker === 'function') {
					tracker({
						event_name: 'lead_submit',
						page: window.location.pathname,
						source: payload.source,
						niche: String(payload.niche || ''),
						element: 'lead_form'
					});
				}

				form.reset();
				feedback.textContent = 'Thank you. Your inquiry has been received, and we will reply within 24 hours.';
				feedback.classList.add('ok');
			} catch {
				feedback.textContent = 'Your inquiry could not be sent. Please try again, or email hello@mvpmedia.studio.';
				feedback.classList.remove('ok');
			} finally {
				button.disabled = false;
				button.textContent = buttonLabel;
			}
		});
	});
</script>

<style>
	.lead-form {
		display: grid;
		gap: 1rem;
		background: linear-gradient(145deg, var(--surface), var(--surface-elevated));
		border: 1px solid var(--stroke);
		border-radius: var(--radius);
		padding: clamp(1.25rem, 3vw, 2rem);
	}
	.field-row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
		gap: 1rem;
	}
	.field {
		display: grid;
		gap: 0.4rem;
	}
	label {
		color: var(--text-primary);
		font-size: 0.78rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.optional {
		color: var(--text-muted);
		text-transform: none;
		letter-spacing: 0;
	}
	input,
	select,
	textarea {
		width: 100%;
		border: 1px solid #343434;
		border-radius: 0.7rem;
		background: #070707;
		color: #f4f4f4;
		padding: 0.8rem 0.9rem;
		font: inherit;
	}
	input:focus,
	select:focus,
	textarea:focus {
		outline: 2px solid var(--brand-deep);
		outline-offset: 1px;
		border-color: var(--brand-deep);
	}
	textarea::placeholder {
		color: #6f6f6f;
	}
	button {
		border: 0;
		border-radius: 999px;
		background: var(--brand-strong);
		color: #0a0a0a;
		font: inherit;
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		padding: 1rem 1.2rem;
		cursor: pointer;
		transition: background 0.2s ease;
	}
	button:hover {
		background: #f1dfbe;
	}
	button:disabled {
		opacity: 0.65;
		cursor: wait;
	}
	.form-note {
		margin: 0;
		font-size: 0.82rem;
		color: var(--text-muted);
	}
	.lead-feedback {
		font-size: 0.95rem;
		color: #f4d2d2;
		min-height: 1.2rem;
		margin: 0;
	}
	.lead-feedback:empty {
		display: none;
	}
	.lead-feedback.ok {
		color: #8bef9f;
	}
</style>
