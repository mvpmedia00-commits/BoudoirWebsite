---
const services = [
  { title: 'Creative Strategy', text: 'Hook, Storyline, Format und Zielsetzung klar vor Produktion.' },
  { title: 'Film Shooting', text: 'On-location oder Studio. Planbar, effizient, hochwertig.' },
  { title: 'Video Cutting', text: 'Schnitte, die Tempo halten und Botschaften transportieren.' },
  { title: 'Visual Enhancements', text: 'Motion, Textlayer und Effekte fuer Plattform-Relevanz.' },
  { title: 'Color Grading', text: 'Cinematic Look mit konsistenter Markenwirkung.' },
  { title: 'Audio Design', text: 'Sounddesign, Voice und Mix fuer professionellen Eindruck.' }
];
---

<section class="hub-section services">
  <div class="intro">
    <p class="eyebrow">Leistungen</p>
    <h2>Eine Videoagentur, alles was du brauchst.</h2>
  </div>
  <div class="grid">
    {services.map((service) => (
      <article>
        <h3>{service.title}</h3>
        <p>{service.text}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .services { margin-top: 1rem; }
  .intro { margin-bottom: 0.8rem; }
  .eyebrow {
    color: #ff8da1;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    margin: 0 0 0.35rem;
  }
  h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(1.7rem, 4vw, 2.9rem);
    line-height: 1.1;
    max-width: 18ch;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }
  article {
    background: #141414;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 20px;
    padding: 1rem;
  }
  h3 { margin: 0 0 0.35rem; color: #ff8da1; font-size: 1rem; }
  p { margin: 0; color: #b1b1b1; font-size: 0.95rem; }
  @media (max-width: 980px) {
    .grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
