---
import { SITE_MEDIA } from '../data/siteMedia';

const formats = [
  { title: 'Weil Wiedererkennbarkeit kein Zufall ist.', image: SITE_MEDIA.one, statA: '+100%', statB: '+100%' },
  { title: 'Weil schlechter Schnitt gute Botschaft ruiniert.', image: SITE_MEDIA.two, statA: '+100%', statB: '+15Mio.' },
  { title: 'Weil Standard im Feed untergeht.', image: SITE_MEDIA.three, statA: '+1Mio.', statB: '+10K' },
  { title: 'Weil Behauptungen nichts beweisen.', image: SITE_MEDIA.four, statA: '+50%', statB: '+4.5%' },
  { title: 'Weil Langeweile schlimmer ist als Laenge.', image: SITE_MEDIA.five, statA: '+0%', statB: '+100%' }
];
---

<section class="hub-section formats">
  {formats.map((item) => (
    <article class="format-card">
      <div class="copy">
        <p class="eyebrow">Format</p>
        <h3>{item.title}</h3>
        <div class="stats"><span>{item.statA}</span><span>{item.statB}</span></div>
        <a href="/booking" class="cta">Video ansehen</a>
      </div>
      <img src={item.image} alt={item.title} loading="lazy" />
    </article>
  ))}
</section>

<style>
  .formats {
    display: grid;
    gap: 0.95rem;
    margin-top: 1rem;
  }
  .format-card {
    background: #0f0f0f;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 24px;
    padding: 0.7rem;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 0.7rem;
    align-items: stretch;
  }
  .copy {
    display: grid;
    align-content: center;
    padding: 0.45rem;
  }
  .eyebrow {
    color: #ff8da1;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    margin: 0 0 0.35rem;
  }
  h3 {
    margin: 0 0 0.7rem;
    font-size: clamp(1.2rem, 3.2vw, 2rem);
    line-height: 1.08;
    color: #f5f5f5;
    max-width: 18ch;
  }
  .stats {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
  }
  .stats span {
    background: #181818;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 999px;
    padding: 0.25rem 0.6rem;
    color: #d9d9d9;
    font-weight: 700;
    font-size: 0.82rem;
  }
  .cta {
    width: fit-content;
    text-decoration: none;
    color: #171717;
    background: #ff8da1;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    font-weight: 700;
  }
  img {
    width: 100%;
    height: 100%;
    min-height: 220px;
    object-fit: cover;
    border-radius: 17px;
  }
  @media (max-width: 860px) {
    .format-card {
      grid-template-columns: 1fr;
    }
  }
</style>
