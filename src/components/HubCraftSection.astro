---
import { SITE_MEDIA } from '../data/siteMedia';

const pillars = [
  { title: 'Strategie', text: 'Plattform, Zielgruppe und Hook werden vor dem Dreh festgelegt.' },
  { title: 'Produktion', text: 'Effiziente Sets, saubere Lichtfuehrung und klare Regie.' },
  { title: 'Postproduktion', text: 'Schnitt, Color, Sound und Motion fuer maximale Wirkung.' }
];
---

<section class="hub-section craft">
  <div class="heading">
    <p class="eyebrow">Wie?</p>
    <h2>Unser Handwerk</h2>
  </div>
  <div class="craft-grid">
    <div class="stack">
      {pillars.map((item) => (
        <article class="pill">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
    <div class="mosaic">
      <img src={SITE_MEDIA.about} alt="Behind the scenes production" loading="lazy" />
      <img src={SITE_MEDIA.four} alt="Team and camera setup" loading="lazy" />
    </div>
  </div>
</section>

<style>
  .craft { margin-top: 1rem; }
  .heading { margin-bottom: 0.75rem; }
  .eyebrow {
    color: #ff8da1;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    margin: 0 0 0.35rem;
  }
  h2 {
    margin: 0;
    font-size: clamp(1.8rem, 5vw, 3rem);
    color: #ff8da1;
  }
  .craft-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .stack { display: grid; gap: 0.7rem; }
  .pill {
    background: #121212;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 20px;
    padding: 1rem;
  }
  h3 { margin: 0 0 0.4rem; color: #fff; font-size: 1.16rem; }
  p { margin: 0; color: #b0b0b0; }
  .mosaic {
    background: #121212;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 20px;
    padding: 0.7rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
  }
  .mosaic img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    border-radius: 14px;
  }
  @media (max-width: 860px) {
    .craft-grid { grid-template-columns: 1fr; }
    .mosaic img { height: 210px; }
  }
</style>
