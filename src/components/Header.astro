---
import { getCollection } from 'astro:content';
import { EXPLICIT_PREF_KEY, SITE_TITLE } from '../consts';
import { MODEL_APPLY_URL } from '../data/offers';
import { getStoreItems } from '../lib/store';
import BookBar from './BookBar.astro';
import EntryGate from './EntryGate.astro';
import HeaderLink from './HeaderLink.astro';

// Only link the journal once there is something to read.
const hasJournal = (await getCollection('blog', ({ data }) => !data.draft)).length > 0;
// The store link appears once there is at least one item to show.
const hasStore = (await getStoreItems()).length > 0;

const links: { href: string; label: string; external?: boolean }[] = [
	{ href: '/gallery', label: 'Portfolio' },
	{ href: '/films', label: 'Films' },
	...(hasStore ? [{ href: '/store', label: 'Store' }] : []),
	{ href: '/pricing', label: 'Pricing' },
	{ href: '/about', label: 'About' },
	...(hasJournal ? [{ href: '/blog', label: 'Journal' }] : []),
	{ href: '/vault', label: 'Vault' },
	{ href: MODEL_APPLY_URL, label: 'Apply to Model', external: true }
];
---

<EntryGate />

<header class="site-header">
	<nav class="nav-shell" aria-label="Primary">
		<a class="brand" href="/">{SITE_TITLE}</a>
		<button
			class="menu-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="site-menu"
			data-menu-toggle
		>
			<span class="menu-icon" aria-hidden="true"></span>
			<span class="menu-label">Menu</span>
		</button>
		<div class="menu" id="site-menu" data-menu>
			<ul class="internal-links">
				{links.map((link) => (
					<li>
						<HeaderLink
							href={link.href}
							target={link.external ? '_blank' : undefined}
							rel={link.external ? 'noopener noreferrer' : undefined}
						>
							{link.label}
							{link.external && <span class="sr-only"> (opens in a new tab)</span>}
						</HeaderLink>
					</li>
				))}
			</ul>
			<button
				class="blur-switch"
				type="button"
				role="switch"
				aria-checked="false"
				title="Off shows a PG-13 version of the site. On shows everything, including nudity."
				data-blur-switch
			>
				<span class="blur-label">NSFW</span>
				<span class="blur-track" aria-hidden="true"><span class="blur-thumb"></span></span>
				<span class="blur-state" aria-hidden="true" data-blur-state>Off</span>
			</button>
			<a class="book-link" href="/booking">Book a Consultation</a>
		</div>
	</nav>
</header>
<BookBar />

<script define:vars={{ explicitKey: EXPLICIT_PREF_KEY }}>
	// Explicit switch: Off = PG-13 version, On = everything. BaseHead.astro sets html.explicit before
	// paint. Changing mode reloads the page so the right photos and videos load from the start.
	const root = document.documentElement;
	const modeSwitch = document.querySelector('[data-blur-switch]');
	const modeState = document.querySelector('[data-blur-state]');
	const on = root.classList.contains('explicit');
	modeSwitch?.setAttribute('aria-checked', String(on));
	if (modeState) modeState.textContent = on ? 'On' : 'Off';

	// Saves the choice everywhere it can (Safari can block localStorage), then reloads. If nothing could
	// be saved, the choice rides along in the address (?explicit=on) so the switch still works.
	const setExplicit = (value) => {
		const mode = value ? 'on' : 'off';
		try { localStorage.setItem(explicitKey, mode); } catch (e) {}
		try { sessionStorage.setItem(explicitKey, mode); } catch (e) {}
		try { document.cookie = `${explicitKey}=${mode}; path=/; max-age=31536000; samesite=lax`; } catch (e) {}
		const saved = () => {
			try { if (localStorage.getItem(explicitKey) === mode) return true; } catch (e) {}
			try { if (sessionStorage.getItem(explicitKey) === mode) return true; } catch (e) {}
			try { return document.cookie.indexOf(`${explicitKey}=${mode}`) !== -1; } catch (e) { return false; }
		};
		root.classList.toggle('explicit', value);
		const url = new URL(location.href);
		if (saved()) url.searchParams.delete('explicit');
		else url.searchParams.set('explicit', mode);
		if (url.href === location.href) location.reload();
		else location.replace(url.href);
	};
	modeSwitch?.addEventListener('click', () => setExplicit(!root.classList.contains('explicit')));
	// "Turn on Explicit" buttons on PG-13 stand-ins (ExplicitLock.astro).
	document.addEventListener('click', (event) => {
		if (event.target instanceof Element && event.target.closest('[data-explicit-on]')) setExplicit(true);
	});
	// This script runs before the page body exists, so media setup waits for it.
	document.addEventListener('DOMContentLoaded', () => {
		// Last-resort mode (storage blocked): keep ?explicit= on the site's own links so the choice
		// survives moving between pages.
		const forced = new URLSearchParams(location.search).get('explicit');
		if (forced === 'on' || forced === 'off') {
			document.querySelectorAll('a[href]').forEach((link) => {
				const target = new URL(link.href, location.href);
				if (target.origin !== location.origin || target.hash && target.pathname === location.pathname) return;
				target.searchParams.set('explicit', forced);
				link.href = target.href;
			});
		}
		// Video preview frames are fetched even for hidden videos, so they are stored as data-poster and
		// applied only to videos on show in the current mode (and current screen layout).
		document.querySelectorAll('video[data-poster]').forEach((video) => {
			if (video.getClientRects().length) video.setAttribute('poster', video.getAttribute('data-poster'));
		});
		// Iframes (films) that may contain nudity load only in Explicit mode.
		if (on) {
			document.querySelectorAll('iframe[data-explicit-src]').forEach((frame) => {
				frame.setAttribute('src', frame.getAttribute('data-explicit-src'));
			});
		}
	});
</script>

<script>
	// Image protection: block right-click and drag saving of photos and videos, and hide the browser's
	// own video download button. Screenshots can't be blocked, but this stops casual saving.
	const isMedia = (target: EventTarget | null) =>
		target instanceof Element && !!target.closest('img, video, picture, canvas, .photo-track, [data-protect]');
	document.addEventListener('contextmenu', (event) => {
		if (isMedia(event.target)) event.preventDefault();
	});
	document.addEventListener('dragstart', (event) => {
		if (isMedia(event.target)) event.preventDefault();
	});
	const protectVideos = () => {
		document.querySelectorAll('video').forEach((video) => {
			video.setAttribute('controlslist', 'nodownload');
			video.setAttribute('disableremoteplayback', '');
		});
	};
	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', protectVideos);
	else protectVideos();
</script>

<script>
	// iPhones in Low Power Mode (and some Android battery savers) block autoplaying video until the
	// visitor touches the page. On the first tap or click anywhere, start every loaded background
	// video that is on screen; later plays started by scrolling then work normally.
	const unlockVideos = () => {
		document.querySelectorAll<HTMLVideoElement>('video[autoplay]').forEach((video) => {
			if (!video.currentSrc && !video.src) return;
			const box = video.getBoundingClientRect();
			const onScreen = box.bottom > 0 && box.top < window.innerHeight && box.width > 0;
			if (onScreen && video.paused) void video.play().catch(() => {});
		});
	};
	['touchend', 'click'].forEach((type) => document.addEventListener(type, unlockVideos, { once: true, passive: true }));

	// Publish the header's height so sticky sub-navigation (e.g. on /films) can sit right below it.
	const siteHeader = document.querySelector<HTMLElement>('.site-header');
	if (siteHeader) {
		const setHeaderHeight = () =>
			document.documentElement.style.setProperty('--header-h', `${siteHeader.offsetHeight}px`);
		setHeaderHeight();
		if ('ResizeObserver' in window) new ResizeObserver(setHeaderHeight).observe(siteHeader);
	}

	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const menu = document.querySelector<HTMLElement>('[data-menu]');
	if (toggle && menu) {
		const setOpen = (open: boolean) => {
			toggle.setAttribute('aria-expanded', String(open));
			menu.classList.toggle('is-open', open);
			document.body.classList.toggle('menu-open', open);
		};
		toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menu.classList.contains('is-open')) {
				setOpen(false);
				toggle.focus();
			}
		});
		window.matchMedia('(min-width: 1521px)').addEventListener('change', (event) => {
			if (event.matches) setOpen(false);
		});
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(7, 7, 7, 0.88);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--stroke);
	}
	.nav-shell {
		max-width: 1320px;
		margin: 0 auto;
		padding: 0.85rem clamp(1rem, 3vw, 2rem);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}
	.brand {
		color: var(--text-primary);
		text-decoration: none;
		font-weight: 700;
		font-size: 1rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		white-space: nowrap;
	}
	.menu {
		display: flex;
		align-items: center;
		gap: 1.75rem;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 1.6rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.internal-links :global(a) {
		color: var(--text-muted);
		font-size: 0.82rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		text-decoration: none;
		padding: 0.35rem 0;
		border-bottom: 1px solid transparent;
		transition: color 0.2s ease, border-color 0.2s ease;
	}
	.internal-links :global(a:hover),
	.internal-links :global(a.active) {
		color: var(--text-primary);
		border-bottom-color: var(--brand-strong);
	}
	.book-link {
		color: #0a0a0a;
		background: var(--brand-strong);
		text-decoration: none;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		padding: 0.7rem 1.15rem;
		border-radius: 999px;
		white-space: nowrap;
		transition: background 0.2s ease;
	}
	.book-link:hover {
		background: #f1dfbe;
	}
	.blur-switch {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.45rem 0.2rem;
		background: none;
		border: 0;
		color: var(--text-muted);
		font: inherit;
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		white-space: nowrap;
		cursor: pointer;
		transition: color 0.2s ease;
	}
	.blur-switch:hover {
		color: var(--text-primary);
	}
	.blur-track {
		position: relative;
		width: 34px;
		height: 18px;
		border-radius: 999px;
		background: #2a2522;
		border: 1px solid var(--stroke);
		transition: background 0.2s ease, border-color 0.2s ease;
	}
	.blur-thumb {
		position: absolute;
		top: 2px;
		left: 2px;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--text-muted);
		transition: transform 0.2s ease, background 0.2s ease;
	}
	.blur-switch[aria-checked='true'] .blur-track {
		background: rgba(212, 194, 161, 0.25);
		border-color: var(--brand-strong);
	}
	.blur-switch[aria-checked='true'] .blur-thumb {
		transform: translateX(16px);
		background: var(--brand-strong);
	}
	.blur-state {
		min-width: 1.8em;
		color: var(--text-primary);
	}
	.menu-toggle {
		display: none;
		align-items: center;
		gap: 0.6rem;
		background: none;
		border: 1px solid var(--stroke);
		border-radius: 999px;
		color: var(--text-primary);
		font: inherit;
		font-size: 0.78rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		padding: 0.55rem 0.95rem;
		cursor: pointer;
	}
	.menu-icon,
	.menu-icon::before,
	.menu-icon::after {
		display: block;
		width: 16px;
		height: 1.5px;
		background: currentColor;
		transition: transform 0.2s ease, opacity 0.2s ease;
	}
	.menu-icon {
		position: relative;
	}
	.menu-icon::before,
	.menu-icon::after {
		content: '';
		position: absolute;
		left: 0;
	}
	.menu-icon::before {
		top: -5px;
	}
	.menu-icon::after {
		top: 5px;
	}
	.menu-toggle[aria-expanded='true'] .menu-icon {
		background: transparent;
	}
	.menu-toggle[aria-expanded='true'] .menu-icon::before {
		transform: translateY(5px) rotate(45deg);
	}
	.menu-toggle[aria-expanded='true'] .menu-icon::after {
		transform: translateY(-5px) rotate(-45deg);
	}

	/* Pricing and Apply to Model sit in the bar with the booking button. Below 1,520px it collapses into the Menu button. */
	@media (max-width: 1520px) {
		.menu-toggle {
			display: inline-flex;
		}
		.menu {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 1.25rem;
			padding: 1.25rem clamp(1rem, 3vw, 2rem) 1.75rem;
			background: #070707;
			box-shadow: 0 24px 40px rgba(0, 0, 0, 0.6);
			border-bottom: 1px solid var(--stroke);
		}
		.menu.is-open {
			display: flex;
		}
		.internal-links {
			flex-direction: column;
			align-items: stretch;
			gap: 0;
		}
		.internal-links :global(a) {
			display: block;
			padding: 0.95rem 0;
			font-size: 0.9rem;
			border-bottom: 1px solid var(--stroke);
		}
		.internal-links :global(a.active) {
			border-bottom-color: var(--stroke);
			color: var(--brand-strong);
		}
		.book-link {
			text-align: center;
			padding: 0.95rem 1.15rem;
		}
		.blur-switch {
			justify-content: space-between;
			padding: 0.4rem 0;
			font-size: 0.82rem;
		}
		.blur-label {
			margin-right: auto;
		}
	}
	:global(body.menu-open) {
		overflow: hidden;
	}
</style>
