---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav class="nav-shell">
		<h2 class="brand"><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links" aria-label="Primary">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/gallery">Gallery</HeaderLink>
			<HeaderLink href="/gallery/editorial-portrait">Editorial</HeaderLink>
			<HeaderLink href="/gallery/boudoir">Boudoir</HeaderLink>
			<HeaderLink href="/hub">Hub</HeaderLink>
			<HeaderLink href="/editor-lab">Editor Lab</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/vault">Vault</HeaderLink>
			<HeaderLink href="/booking">Consultation</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<a href="/#contact">Contact</a>
		</div>
		<a class="book-link" href="/booking">Book Consultation</a>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		padding: 0.8rem 1rem;
		background: rgba(7, 7, 7, 0.9);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--stroke);
	}
	.nav-shell {
		width: 100%;
		margin: 0;
		display: flex;
		align-items: center;
		gap: 1rem;
		justify-content: space-between;
	}
	.brand {
		margin: 0;
		font-size: 1.05rem;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}
	.brand a {
		text-decoration: none;
		color: var(--text-primary);
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.internal-links a {
		padding: 0.4rem 0.7rem;
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.95rem;
		border-radius: 999px;
	}
	.internal-links a:hover,
	.internal-links a.active {
		background: rgba(157, 135, 95, 0.2);
		color: var(--text-primary);
	}
	.book-link {
		background: var(--brand-strong);
		color: #090909;
		text-decoration: none;
		padding: 0.6rem 1rem;
		font-size: 0.85rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		border-radius: 999px;
	}
	.book-link:hover {
		background: #f1dfbe;
	}
	@media (max-width: 760px) {
		.nav-shell {
			flex-wrap: wrap;
		}
		.internal-links {
			order: 3;
			width: 100%;
			justify-content: center;
			padding-top: 0.2rem;
		}
		.book-link {
			margin-left: auto;
		}
	}
</style>
