---
// Stylized media hub section with scroll snapping and media upload box
const mediaSections = [
  {
    title: 'Our Drive',
    description: 'Video portraits, storytelling, and creative highlights. We bring your message into the right format.',
    image: '/assets/sample-drive.jpg',
    cta: 'Learn more',
    ctaLink: '#',
  },
  {
    title: 'Our Craft',
    description: 'Craftsmanship meets modern technology. Every video is unique.',
    image: '/assets/sample-craft.jpg',
    cta: 'Watch showreel',
    ctaLink: '#',
  },
  {
    title: 'Recognition',
    description: 'Distinctive visuals and sharp editing ensure brand recognition and loyalty.',
    image: '/assets/sample-identity.jpg',
    cta: 'See examples',
    ctaLink: '#',
  },
  {
    title: 'Message',
    description: 'Good editing delivers the right message. We don’t just cut, we tell stories.',
    image: '/assets/sample-message.jpg',
    cta: 'Discover now',
    ctaLink: '#',
  },
  {
    title: 'Proof',
    description: 'We deliver results, not just claims. Our projects speak for themselves.',
    image: '/assets/sample-proof.jpg',
    cta: 'References',
    ctaLink: '#',
  },
  {
    title: 'No Boredom',
    description: 'Our videos are engaging and to the point. Not a second too long.',
    image: '/assets/sample-no-boredom.jpg',
    cta: 'See more',
    ctaLink: '#',
  },
  {
    title: 'Perspective',
    description: 'We create new perspectives and emotional moments.',
    image: '/assets/sample-perspective.jpg',
    cta: 'Contact us',
    ctaLink: '#',
  },
];
---

<section class="max-w-5xl mx-auto px-4">
  <!-- Media Upload Box -->
  <div class="flex justify-center mb-12">
    <div class="bg-neutral-800 border-2 border-dashed border-pink-400 rounded-2xl p-8 w-full max-w-xl flex flex-col items-center gap-4 shadow-lg">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-pink-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5-5m0 0l5 5m-5-5v12" /></svg>
      <p class="text-neutral-300">Drag & drop media here or <span class="text-pink-400 underline cursor-pointer">browse</span></p>
      <input type="file" class="hidden" multiple />
    </div>
  </div>
  <!-- Scrollable Media Sections -->
  <div class="snap-y snap-mandatory overflow-y-auto max-h-[80vh] space-y-16 pb-8" style="scroll-behavior:smooth;">
    {mediaSections.map((section, idx) => (
      <div class={`snap-center flex flex-col md:flex-row ${idx % 2 === 1 ? 'md:flex-row-reverse' : ''} items-center gap-8 bg-neutral-800 rounded-2xl p-8 shadow-lg`}>
        <img src={section.image} alt={section.title} class="w-full md:w-1/2 rounded-xl object-cover aspect-video" loading="lazy" />
        <div class="flex-1">
          <h2 class="text-3xl font-bold text-pink-400 mb-2">{section.title}</h2>
          <p class="text-neutral-200 mb-4">{section.description}</p>
          <a href={section.ctaLink} class="inline-block bg-pink-500 hover:bg-pink-400 text-white font-semibold px-6 py-2 rounded-full transition">{section.cta}</a>
        </div>
      </div>
    ))}
  </div>
</section>
