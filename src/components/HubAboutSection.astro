---
import { SITE_MEDIA } from '../data/siteMedia';
---

<section class="hub-section two-col">
  <div class="panel">
    <p class="eyebrow">Wer?</p>
    <h2>Unser Antrieb</h2>
    <p>Wir verbinden Konzept, Produktion und Postproduktion in einem Ablauf. Keine Reibung. Kein Content von der Stange.</p>
    <a class="cta" href="/booking">Jetzt anfragen</a>
  </div>
  <div class="media-card">
    <img src={SITE_MEDIA.about} alt="MVP Media Team at work" loading="lazy" />
  </div>
</section>

<style>
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1rem;
  }
  .panel,
  .media-card {
    background: #131313;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 24px;
    padding: 1rem;
  }
  .eyebrow {
    color: #ff8da1;
    margin: 0 0 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
  }
  h2 {
    margin: 0 0 0.8rem;
    font-size: clamp(1.8rem, 5vw, 3rem);
    color: #ff8da1;
    line-height: 1.04;
  }
  p {
    margin: 0 0 1rem;
    color: #b8b8b8;
    max-width: 45ch;
  }
  .cta {
    text-decoration: none;
    color: #171717;
    background: #ff8da1;
    border-radius: 999px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    font-weight: 700;
    padding: 0.58rem 0.95rem;
  }
  img {
    width: 100%;
    height: 100%;
    min-height: 280px;
    object-fit: cover;
    border-radius: 18px;
  }
  @media (max-width: 860px) {
    .two-col {
      grid-template-columns: 1fr;
    }
  }
</style>
