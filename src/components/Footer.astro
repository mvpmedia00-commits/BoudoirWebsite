---
const today = new Date();
---

<footer>
	<div class="footer-shell">
		<p>&copy; {today.getFullYear()} MVP Media · Matthew Phillips</p>
		<p class="muted">Boudoir, artistic nude, and afterdark adult portrait sessions with discreet premium delivery.</p>
		<div class="links">
			<a href="mailto:hello@mvpmedia.studio">hello@mvpmedia.studio</a>
			<a href="/gallery">View Gallery</a>
		</div>
	</div>
</footer>
<style>
	footer {
		padding: 2.4rem 1rem 3.2rem;
		background: #070707;
		border-top: 1px solid var(--stroke);
		color: var(--text-primary);
	}
	.footer-shell {
		width: 100%;
		margin: 0;
		text-align: center;
	}
	p {
		margin: 0.3rem 0;
	}
	.muted {
		color: var(--text-muted);
	}
	.links {
		margin-top: 0.7rem;
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}
	.links a {
		text-decoration: none;
		color: var(--brand-strong);
	}
</style>
