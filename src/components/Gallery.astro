---
// This is a placeholder gallery component. Replace with your own logic or connect to a CMS or Cloudinary for dynamic images.
const images = [
  '/assets/photo1.jpg',
  '/assets/photo2.jpg',
  '/assets/photo3.jpg',
];
---

<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
  {images.map((src) => (
    <img src={src} alt="Gallery image" class="rounded shadow" loading="lazy" />
  ))}
</div>
