---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, category, tags } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				padding-top: 1.4rem;
			}
			.article-wrap {
				max-width: 860px;
				margin: 0 auto;
				background: linear-gradient(145deg, var(--surface), var(--surface-elevated));
				border: 1px solid var(--stroke);
				border-radius: var(--radius);
				overflow: hidden;
			}
			.hero-image img {
				width: 100%;
				border-radius: 0;
				aspect-ratio: 16 / 8;
				object-fit: cover;
			}
			.prose {
				max-width: 760px;
				margin: 0 auto;
				padding: 1.3rem 1rem 1.8rem;
			}
			.title {
				margin-bottom: 1rem;
				padding-bottom: 0.9rem;
				border-bottom: 1px solid var(--stroke);
			}
			.title h1 {
				margin: 0.4rem 0 0;
				line-height: 1.06;
			}
			.date {
				font-size: 0.82rem;
				text-transform: uppercase;
				letter-spacing: 0.07em;
				color: var(--text-muted);
				display: grid;
				gap: 0.2rem;
			}
			.meta-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
				margin-top: 0.65rem;
			}
			.meta-links a {
				display: inline-block;
				padding: 0.25rem 0.55rem;
				border: 1px solid var(--stroke);
				border-radius: 999px;
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				text-decoration: none;
				color: var(--text-muted);
			}
			.meta-links a:hover {
				color: var(--text-primary);
				background: rgba(157, 135, 95, 0.2);
			}
			.last-updated-on {
				font-style: italic;
			}
			.article-content {
				font-size: 1.03rem;
				line-height: 1.72;
				color: var(--text-muted);
			}
			.article-content :global(p) {
				margin: 0 0 1.05rem;
			}
			.article-content :global(h2),
			.article-content :global(h3),
			.article-content :global(h4) {
				margin-top: 1.4rem;
				margin-bottom: 0.6rem;
				line-height: 1.2;
			}
			.article-content :global(ul),
			.article-content :global(ol) {
				margin: 0 0 1rem;
				padding-left: 1.25rem;
			}
			.article-content :global(blockquote) {
				margin: 1.25rem 0;
				padding: 0.8rem 1rem;
				border-left: 2px solid var(--brand-deep);
				background: rgba(255, 255, 255, 0.02);
				border-radius: 0 10px 10px 0;
			}
			.article-content :global(pre) {
				overflow-x: auto;
				padding: 0.9rem;
				border-radius: 10px;
				background: rgba(0, 0, 0, 0.35);
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article class="article-wrap">
				<div class="hero-image">
					{heroImage && <Image width={1440} height={720} src={heroImage} alt={title} />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<div><FormattedDate date={pubDate} /></div>
							{
								updatedDate && (
									<div class="last-updated-on">
										Updated <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<div class="meta-links">
							<a href={`/blog/category/${category}/`}>{category.replaceAll('-', ' ')}</a>
							{tags?.map((tag) => <a href={`/blog/tag/${tag.toLowerCase()}/`}>#{tag}</a>)}
						</div>
						<h1>{title}</h1>
					</div>
					<div class="article-content">
						<slot />
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
