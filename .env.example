# Canonical production URL, used for sitemap and canonical links.
PUBLIC_SITE_URL=https://boudoir-website.vercel.app

# PocketBase backend (leads, analytics events, media items).
POCKETBASE_URL=https://your-pocketbase.fly.dev
POCKETBASE_ADMIN_TOKEN=

# Admin lead feed: open /admin/feed?token=<ADMIN_DASH_TOKEN> once to sign in.
ADMIN_DASH_TOKEN=replace_with_long_random_value

# Members vault access code. Checked on the server only; never sent to the browser.
VAULT_ACCESS_CODE=replace_with_private_access_code
